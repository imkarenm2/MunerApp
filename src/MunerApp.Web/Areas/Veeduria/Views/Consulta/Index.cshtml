@model List<FundacionVeeduriaItem>
@{
    ViewData["Title"] = "Veeduría ciudadana";
}
<section class="cabecera-pagina">
    <div class="container">
        <span class="sobretitulo">Veeduría ciudadana</span>
        <h1 class="mb-2">Lo que reciben las fundaciones, y en qué se usa</h1>
        <p class="lead text-suave mb-0" style="max-width: 760px">
            Consulta de solo lectura para hacer seguimiento a las fundaciones de MunerApp (Ley 850 de 2003).
            Ves donaciones, causas, rendición de cuentas y donaciones en especie, sin datos personales de los donantes.
        </p>
    </div>
</section>

<div class="container py-4 py-md-5">
    <p class="small text-suave mb-3">Cifras de los últimos 12 meses. Las alertas marcan lo que vale la pena revisar con la fundación.</p>
    @if (Model.Count == 0)
    {
        <div class="estado-vacio"><h2 class="h5">Aún no hay fundaciones activas.</h2></div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var f in Model)
            {
                var alertas = f.CausasCerradasSinRendicion + (f.DonacionesSinRevisar > 0 ? 1 : 0) + (f.DocumentosPublicados == 0 ? 1 : 0);
                <div class="col-12 col-lg-6">
                    <a class="mu-card mu-card-hover p-4 d-block h-100 text-decoration-none text-body" asp-action="Fundacion" asp-route-id="@f.Id">
                        <div class="d-flex justify-content-between gap-2 mb-1">
                            <h2 class="h5 mb-0">@f.Nombre</h2>
                            @if (alertas > 0)
                            {
                                <span class="mu-badge alerta flex-shrink-0"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i>@alertas @(alertas == 1 ? "alerta" : "alertas")</span>
                            }
                        </div>
                        <div class="small text-suave mb-3">NIT @f.Nit@(string.IsNullOrEmpty(f.Ciudad) ? "" : " · " + f.Ciudad)</div>
                        <div class="row g-2 small">
                            <div class="col-6"><span class="d-block fw-bold text-principal">@Formatos.Pesos(f.DineroConfirmado)</span>en @f.DonacionesDinero donaciones</div>
                            <div class="col-6"><span class="d-block fw-bold text-principal">@f.DonacionesEspecie</span>donaciones en especie recibidas</div>
                        </div>
                        @if (alertas > 0)
                        {
                            <ul class="small mt-3 mb-0 ps-3">
                                @if (f.CausasCerradasSinRendicion > 0)
                                {
                                    <li>@f.CausasCerradasSinRendicion @(f.CausasCerradasSinRendicion == 1 ? "causa terminó" : "causas terminaron") sin rendición de cuentas publicada</li>
                                }
                                @if (f.DonacionesSinRevisar > 0)
                                {
                                    <li>@f.DonacionesSinRevisar @(f.DonacionesSinRevisar == 1 ? "donación lleva" : "donaciones llevan") más de una semana sin revisar</li>
                                }
                                @if (f.DocumentosPublicados == 0)
                                {
                                    <li>No ha publicado documentos de transparencia</li>
                                }
                            </ul>
                        }
                    </a>
                </div>
            }
        </div>
    }
</div>
