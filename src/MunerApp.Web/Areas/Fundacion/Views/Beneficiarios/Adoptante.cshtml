@model AdoptanteFormViewModel
@{
    ViewData["Title"] = "Adoptante de " + Model.NombreBeneficiario;
    ViewData["Seccion"] = "Beneficiarios";
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
    var desde = Model.FechaRescate.ToString("yyyy-MM-dd");
}
<div class="container py-4 py-md-5" style="max-width: 720px">
    <a asp-action="Detalle" asp-route-id="@Model.BeneficiarioId" class="small fw-semibold text-decoration-none"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Hoja de vida de @Model.NombreBeneficiario</a>
    <h1 class="h2 mt-2 mb-1">@(Model.YaRegistrado ? "Editar" : "Registrar") adoptante</h1>
    <p class="text-suave mb-4">Con estos datos la fundación podrá hacer el seguimiento de @Model.NombreBeneficiario después de la adopción.</p>

    <form asp-action="Adoptante" asp-route-id="@Model.BeneficiarioId" method="post" novalidate class="mu-card p-4 p-md-5">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" maxlength="150" autocomplete="off" />
                <span asp-validation-for="Nombre"></span>
            </div>
            <div class="col-12 col-sm-6">
                <label asp-for="Documento" class="form-label"></label>
                <input asp-for="Documento" class="form-control" inputmode="numeric" maxlength="12" autocomplete="off" />
                <span asp-validation-for="Documento"></span>
            </div>
            <div class="col-12 col-sm-6">
                <label asp-for="Telefono" class="form-label"></label>
                <input asp-for="Telefono" class="form-control" type="tel" maxlength="16" placeholder="3001234567" autocomplete="off" />
                <span asp-validation-for="Telefono"></span>
            </div>
            <div class="col-12">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" type="email" maxlength="150" autocomplete="off" />
                <span asp-validation-for="Correo"></span>
            </div>
            <div class="col-12 col-sm-5">
                <label asp-for="Ciudad" class="form-label"></label>
                <input asp-for="Ciudad" class="form-control" maxlength="100" autocomplete="off" />
                <span asp-validation-for="Ciudad"></span>
            </div>
            <div class="col-12 col-sm-7">
                <label asp-for="Direccion" class="form-label"></label>
                <input asp-for="Direccion" class="form-control" maxlength="200" autocomplete="off" />
                <span asp-validation-for="Direccion"></span>
            </div>
            <div class="col-12 col-sm-6">
                <label asp-for="FechaAdopcion" class="form-label"></label>
                <input asp-for="FechaAdopcion" type="date" class="form-control" min="@desde" max="@hoy" />
                <span asp-validation-for="FechaAdopcion"></span>
            </div>
            <div class="col-12">
                <label asp-for="Observaciones" class="form-label"></label>
                <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="500" placeholder="Condiciones de la entrega, acuerdos de seguimiento…"></textarea>
                <span asp-validation-for="Observaciones"></span>
            </div>
        </div>
        <div class="alert alert-info small mt-4 mb-0">
            <i class="bi bi-shield-lock" aria-hidden="true"></i>
            <div>Son datos personales: solo los ven los administradores de la fundación. No se publican.</div>
        </div>
        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
            <button type="submit" class="btn btn-primary" data-cargando="Guardando...">Guardar adoptante</button>
            <a asp-action="Detalle" asp-route-id="@Model.BeneficiarioId" class="btn btn-link">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
