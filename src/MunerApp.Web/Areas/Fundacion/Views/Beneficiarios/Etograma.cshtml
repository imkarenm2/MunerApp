@model EtogramaFormViewModel
@{
    ViewData["Title"] = "Etograma de " + Model.NombreBeneficiario;
    ViewData["Seccion"] = "Beneficiarios";
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
}
<div class="container py-4 py-md-5" style="max-width: 980px">
    <a asp-action="Detalle" asp-route-id="@Model.BeneficiarioId" class="small fw-semibold text-decoration-none"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Hoja de vida de @Model.NombreBeneficiario</a>
    <h1 class="h2 mt-2 mb-1">Etograma</h1>
    <p class="text-suave mb-4">Marca las conductas que observaste en @Model.NombreBeneficiario en su ambiente habitual. Método: muestreo continuo focal.</p>

    <form asp-action="Etograma" asp-route-id="@Model.BeneficiarioId" method="post" novalidate class="mu-card p-4 p-md-5">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-md-7">
                <span class="form-label d-block" id="etiqueta-momento">Momento de la evaluación</span>
                <div class="d-flex flex-wrap gap-2" role="radiogroup" aria-labelledby="etiqueta-momento">
                    @foreach (var m in Enum.GetValues<MomentoEtograma>())
                    {
                        <input type="radio" class="btn-check" name="Momento" id="momento-@m" value="@m" checked="@(Model.Momento == m)" />
                        <label class="chip" for="momento-@m">@Textos.De(m)</label>
                    }
                </div>
                <span asp-validation-for="Momento"></span>
            </div>
            <div class="col-12 col-md-5">
                <label asp-for="Fecha" class="form-label"></label>
                <input asp-for="Fecha" type="date" class="form-control" max="@hoy" />
                <span asp-validation-for="Fecha"></span>
            </div>
        </div>

        <div class="row g-3">
            @foreach (var grupo in Etograma.Grupos)
            {
                <div class="col-12 col-md-4">
                    <fieldset class="etograma-grupo">
                        <legend class="h6 fw-bold">@grupo</legend>
                        @foreach (var c in Etograma.Todas.Where(x => x.Grupo == grupo))
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="Conductas" id="conducta-@c.Codigo" value="@c.Codigo" checked="@Model.Conductas.Contains(c.Codigo)" />
                                <label class="form-check-label small" for="conducta-@c.Codigo">@c.Texto</label>
                            </div>
                        }
                    </fieldset>
                </div>
            }
        </div>
        <span asp-validation-for="Conductas"></span>

        <div class="mt-4">
            <label asp-for="Observaciones" class="form-label"></label>
            <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="1000" data-contador></textarea>
            <span asp-validation-for="Observaciones"></span>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
            <button type="submit" class="btn btn-primary" data-cargando="Guardando...">Guardar etograma</button>
            <a asp-action="Detalle" asp-route-id="@Model.BeneficiarioId" class="btn btn-link">Cancelar</a>
        </div>
    </form>
</div>
