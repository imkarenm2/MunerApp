@model BeneficiarioFormViewModel
@{
    ViewData["Title"] = "Registrar beneficiario";
    ViewData["Seccion"] = "Beneficiarios";
}
<div class="container py-4 py-md-5" style="max-width: 720px">
    <a asp-action="Index" class="small fw-semibold text-decoration-none"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Beneficiarios</a>
    <h1 class="h2 mt-2 mb-1">Registrar beneficiario</h1>
    <p class="text-suave mb-4">Quedará con el estado inicial <strong>En la fundación</strong>. Después podrán cambiarlo desde su hoja de vida.</p>

    <form asp-action="Crear" method="post" enctype="multipart/form-data" novalidate class="mu-card p-4 p-md-5">
        <partial name="_Formulario" model="Model" />
        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
            <button type="submit" class="btn btn-primary" data-cargando="Guardando...">Guardar hoja de vida</button>
            <a asp-action="Index" class="btn btn-link">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
