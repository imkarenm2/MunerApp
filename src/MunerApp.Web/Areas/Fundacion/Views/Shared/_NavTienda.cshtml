@* Sub-secciones de la tienda en el panel: productos (HU-023), chats y pedidos (HU-026) *@
@{
    var controlador = ViewContext.RouteData.Values["controller"] as string;
    string Activa(string c) => c == controlador ? "active" : "";
}
<nav class="nav nav-pills nav-sub mb-3 gap-1" aria-label="Secciones de la tienda">
    <a class="nav-link py-1 px-3 @Activa("Productos")" asp-area="Fundacion" asp-controller="Productos" asp-action="Index"><i class="bi bi-bag me-1" aria-hidden="true"></i>Productos</a>
    <a class="nav-link py-1 px-3 @Activa("ChatsTienda")" asp-area="Fundacion" asp-controller="ChatsTienda" asp-action="Index"><i class="bi bi-chat-dots me-1" aria-hidden="true"></i>Chats</a>
    <a class="nav-link py-1 px-3 @Activa("Pedidos")" asp-area="Fundacion" asp-controller="Pedidos" asp-action="Index"><i class="bi bi-receipt me-1" aria-hidden="true"></i>Pedidos</a>
</nav>
