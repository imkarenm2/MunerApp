@inject MunerApp.Infrastructure.Persistence.MunerAppDbContext Db
@inject MunerApp.Application.Interfaces.IEsalActual EsalActual
@inject MunerApp.Application.Interfaces.IModuloService Modulos
@{
    var esalId = EsalActual.EsalId;
    var moduloBeneficiarios = esalId is not null && await Modulos.EstaActivoAsync(esalId.Value, CodigosModulo.Beneficiarios);
    var slug = esalId is null ? null : Db.Esales.Where(e => e.Id == esalId).Select(e => e.Slug).FirstOrDefault();
    var seccion = ViewData["Seccion"] as string ?? "";
    var principal = User.IsInRole(Roles.AdministradorESAL) && User.HasClaim(MunerAppClaims.Perfil, Perfiles.Principal);
    var admin = User.IsInRole(Roles.AdministradorESAL);
    string Activa(string s) => s == seccion ? "active" : "";
}
@if (slug is not null)
{
    <div class="vista-publica mb-3">
        <span class="small text-suave"><i class="bi bi-globe2 me-1" aria-hidden="true"></i>Así ven los visitantes a su fundación:</span>
        <a class="btn btn-sm btn-outline-primary" href="/fundaciones/@slug" target="_blank" rel="noopener">
            <i class="bi bi-eye me-1" aria-hidden="true"></i>Ver página pública
        </a>
    </div>
}
<nav class="nav nav-pills nav-panel mb-4 flex-nowrap overflow-auto" aria-label="Secciones del panel">
    <a class="nav-link @Activa("Inicio")" asp-area="Fundacion" asp-controller="Panel" asp-action="Index"><i class="bi bi-grid me-1" aria-hidden="true"></i>Inicio</a>
    @if (principal)
    {
        <a class="nav-link @Activa("Perfil")" asp-area="Fundacion" asp-controller="Perfil" asp-action="Index"><i class="bi bi-building me-1" aria-hidden="true"></i>Perfil</a>
        <a class="nav-link @Activa("Documentos")" asp-area="Fundacion" asp-controller="Documentos" asp-action="Index"><i class="bi bi-folder-check me-1" aria-hidden="true"></i>Transparencia</a>
    }
    @if (admin)
    {
        <a class="nav-link @Activa("Donaciones")" asp-area="Fundacion" asp-controller="Donaciones" asp-action="Index"><i class="bi bi-cash-coin me-1" aria-hidden="true"></i>Donaciones</a>
        @if (moduloBeneficiarios)
        {
            <a class="nav-link @Activa("Beneficiarios")" asp-area="Fundacion" asp-controller="Beneficiarios" asp-action="Index"><i class="bi bi-balloon-heart me-1" aria-hidden="true"></i>Beneficiarios</a>
        }
        <a class="nav-link @Activa("Postulaciones")" asp-area="Fundacion" asp-controller="Postulaciones" asp-action="Index"><i class="bi bi-person-raised-hand me-1" aria-hidden="true"></i>Voluntarios</a>
        <a class="nav-link @Activa("Usuarios")" asp-area="Fundacion" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-people me-1" aria-hidden="true"></i>Equipo</a>
    }
    @if (principal)
    {
        <a class="nav-link @Activa("DatosDonacion")" asp-area="Fundacion" asp-controller="DatosDonacion" asp-action="Index"><i class="bi bi-bank me-1" aria-hidden="true"></i>Datos para donar</a>
        <a class="nav-link @Activa("Redes")" asp-area="Fundacion" asp-controller="Redes" asp-action="Index"><i class="bi bi-share me-1" aria-hidden="true"></i>Redes sociales</a>
        <a class="nav-link @Activa("Pasarela")" asp-area="Fundacion" asp-controller="Pasarela" asp-action="Index"><i class="bi bi-credit-card me-1" aria-hidden="true"></i>Pagos en línea</a>
    }
</nav>
