@model HistoriaClinicaViewModel
@{
    ViewData["Title"] = "Historia clínica de " + Model.Nombre;
    ViewData["Seccion"] = "Beneficiarios";
    var iconos = new Dictionary<TipoEventoClinico, string>
    {
        [TipoEventoClinico.Vacuna] = "bi-shield-plus",
        [TipoEventoClinico.Tratamiento] = "bi-capsule",
        [TipoEventoClinico.Control] = "bi-clipboard2-pulse",
        [TipoEventoClinico.Otro] = "bi-journal-medical"
    };
}
<div class="container py-4 py-md-5" style="max-width: 860px">
    <a asp-controller="Beneficiarios" asp-action="Detalle" asp-route-id="@Model.BeneficiarioId" class="small fw-semibold text-decoration-none"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Hoja de vida de @Model.Nombre</a>

    <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mt-2 mb-3">
        <div>
            <h1 class="h2 mb-1">Historia clínica</h1>
            <p class="text-suave mb-0">
                @Model.Nombre · @Formatos.Edad(Model.FechaNacimiento) · <partial name="_EstadoBeneficiario" model="Model.Estado" />
            </p>
        </div>
        <a class="btn btn-primary" asp-action="Crear" asp-route-id="@Model.BeneficiarioId"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Registrar evento</a>
    </div>

    <partial name="_NavFundacion" />

    <div class="alert alert-info small">
        <i class="bi bi-shield-lock" aria-hidden="true"></i>
        <div>Información interna: solo la ven los administradores y los voluntarios de salud de la fundación. Los eventos no se editan ni se borran, para conservar el historial completo.</div>
    </div>

    @if (Model.Eventos.Count == 0)
    {
        <div class="estado-vacio">
            <div class="icono-circulo mb-3"><i class="bi bi-journal-medical" aria-hidden="true"></i></div>
            <h2 class="h5">@Model.Nombre aún no tiene eventos clínicos</h2>
            <p class="text-suave">Registra la primera vacuna, tratamiento o control para empezar su historial.</p>
            <a class="btn btn-primary" asp-action="Crear" asp-route-id="@Model.BeneficiarioId">Registrar el primero</a>
        </div>
    }
    else
    {
        <p class="small text-suave mb-3">@Model.Eventos.Count @(Model.Eventos.Count == 1 ? "evento" : "eventos"), de la fecha más antigua a la más reciente.</p>
        <div class="d-grid gap-3">
            @foreach (var e in Model.Eventos)
            {
                <article class="mu-card p-4 evento-clinico">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="icono-circulo flex-shrink-0" style="width:38px;height:38px;font-size:1.05rem"><i class="bi @iconos[e.Tipo]" aria-hidden="true"></i></span>
                        <span class="fw-bold">@Textos.De(e.Tipo)</span>
                        <span class="text-suave small ms-md-auto">@Formatos.Fecha(e.Fecha)</span>
                    </div>
                    <p class="texto-largo mb-2">@e.Descripcion</p>
                    <p class="small text-suave mb-0">
                        Responsable: <strong class="text-body">@e.Responsable</strong>
                        <span class="d-block d-sm-inline">· Registrado @Formatos.FechaCorta(e.FechaRegistro)@(e.RegistradoPor is null ? "" : " por " + e.RegistradoPor)</span>
                    </p>
                    @if (e.FotoIds.Count > 0)
                    {
                        <div class="evento-fotos mt-3">
                            @foreach (var fotoId in e.FotoIds)
                            {
                                var url = Url.Action("Foto", new { id = fotoId });
                                <a href="@url" target="_blank" rel="noopener" class="evento-foto" aria-label="Abrir la foto en otra pestaña">
                                    <img src="@url" alt="Foto del evento clínico del @Formatos.Fecha(e.Fecha)" loading="lazy" />
                                </a>
                            }
                        </div>
                    }
                </article>
            }
        </div>
    }
</div>
