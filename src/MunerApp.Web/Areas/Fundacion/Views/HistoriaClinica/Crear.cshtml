@model EventoClinicoFormViewModel
@{
    ViewData["Title"] = "Registrar evento clínico";
    ViewData["Seccion"] = "Beneficiarios";
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
    var iconos = new Dictionary<TipoEventoClinico, string>
    {
        [TipoEventoClinico.Vacuna] = "bi-shield-plus",
        [TipoEventoClinico.Tratamiento] = "bi-capsule",
        [TipoEventoClinico.Control] = "bi-clipboard2-pulse",
        [TipoEventoClinico.Otro] = "bi-journal-medical",
        [TipoEventoClinico.Desparasitacion] = "bi-bug",
        [TipoEventoClinico.PruebaViral] = "bi-virus",
        [TipoEventoClinico.Cirugia] = "bi-scissors"
    };
    var orden = new[] { TipoEventoClinico.Vacuna, TipoEventoClinico.Desparasitacion, TipoEventoClinico.PruebaViral, TipoEventoClinico.Control, TipoEventoClinico.Tratamiento, TipoEventoClinico.Cirugia, TipoEventoClinico.Otro };
}
<div class="container py-4 py-md-5" style="max-width: 720px">
    <a asp-action="Index" asp-route-id="@Model.BeneficiarioId" class="small fw-semibold text-decoration-none"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Historia clínica de @Model.NombreBeneficiario</a>
    <h1 class="h2 mt-2 mb-1">Registrar evento clínico</h1>
    <p class="text-suave mb-4">Quedará en la historia clínica de <strong>@Model.NombreBeneficiario</strong>. No se podrá editar después.</p>

    <form asp-action="Crear" asp-route-id="@Model.BeneficiarioId" method="post" enctype="multipart/form-data" novalidate class="mu-card p-4 p-md-5"
          data-confirmar="El evento quedará en el historial de @Model.NombreBeneficiario y no se podrá editar ni borrar."
          data-confirmar-titulo="¿Guardar el evento clínico?" data-confirmar-boton="Sí, guardar">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-12">
                <span class="form-label d-block" id="etiqueta-tipo">Tipo de evento</span>
                <div class="d-flex flex-wrap gap-2" role="radiogroup" aria-labelledby="etiqueta-tipo">
                    @foreach (var t in orden)
                    {
                        <div>
                            <input type="radio" class="btn-check" name="Tipo" id="tipo-@t" value="@t" checked="@(Model.Tipo == t)" data-val="true" data-val-required="Selecciona el tipo de evento." data-tipo-evento />
                            <label class="chip" for="tipo-@t"><i class="bi @iconos[t] me-2" aria-hidden="true"></i>@Textos.De(t)</label>
                        </div>
                    }
                </div>
                <span asp-validation-for="Tipo"></span>
            </div>
            <div class="col-12 col-sm-6">
                <label asp-for="Fecha" class="form-label"></label>
                <input asp-for="Fecha" type="date" class="form-control" max="@hoy" />
                <span asp-validation-for="Fecha"></span>
            </div>
            <div class="col-12 col-sm-6">
                <label asp-for="Responsable" class="form-label"></label>
                <input asp-for="Responsable" class="form-control" maxlength="150" placeholder="Quién atendió o aplicó" autocomplete="off" />
                <span asp-validation-for="Responsable"></span>
            </div>
            <div class="col-12 col-sm-6" data-campo-evento="Vacuna Desparasitacion PruebaViral Tratamiento Cirugia">
                <label asp-for="Producto" class="form-label" data-etiqueta-producto>Vacuna, desparasitante o prueba</label>
                <input asp-for="Producto" class="form-control" maxlength="100" list="productos-clinicos" autocomplete="off" />
                <datalist id="productos-clinicos">
                    @foreach (var v in Etograma.Vacunas) { <option value="@v"></option> }
                    <option value="Galgocal 200"></option>
                    <option value="VIF (inmunodeficiencia felina)"></option>
                    <option value="FeLV (leucemia felina)"></option>
                    <option value="OVH (esterilización)"></option>
                    <option value="Orquiectomía (castración)"></option>
                </datalist>
                <span asp-validation-for="Producto"></span>
            </div>
            <div class="col-12 col-sm-6" data-campo-evento="Vacuna">
                <label asp-for="Laboratorio" class="form-label"></label>
                <input asp-for="Laboratorio" class="form-control" maxlength="100" list="laboratorios" placeholder="Ej.: Feligen, Virbac" autocomplete="off" />
                <datalist id="laboratorios"><option value="Feligen"></option><option value="Virbac"></option><option value="Zoetis"></option><option value="MSD"></option></datalist>
                <span asp-validation-for="Laboratorio"></span>
            </div>
            <div class="col-12 col-sm-6" data-campo-evento="Desparasitacion Control Tratamiento">
                <label asp-for="Peso" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Peso" class="form-control" inputmode="decimal" placeholder="3,5" autocomplete="off" />
                    <span class="input-group-text">kg</span>
                </div>
                <span asp-validation-for="Peso"></span>
            </div>
            <div class="col-12 col-sm-6" data-campo-evento="PruebaViral">
                <label asp-for="Resultado" class="form-label"></label>
                <select asp-for="Resultado" class="form-select">
                    <option value="">Selecciona…</option>
                    <option value="Negativo">Negativo</option>
                    <option value="Positivo">Positivo</option>
                    <option value="No concluyente">No concluyente</option>
                </select>
                <span asp-validation-for="Resultado"></span>
            </div>
            <div class="col-12">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="4" maxlength="1000"
                          placeholder="Ej.: Vacuna triple felina, primera dosis. Sin reacciones adversas."></textarea>
                <span asp-validation-for="Descripcion"></span>
            </div>
            <div class="col-12">
                <label class="form-label" for="Fotos">Fotos (opcional)</label>
                <label class="zona-archivo" for="Fotos">
                    <i class="bi bi-images" aria-hidden="true"></i>
                    <span class="fw-semibold" data-nombre-archivo>Selecciona hasta 5 fotos</span>
                    <span class="small text-suave">@ValidadorArchivos.Ayuda(TipoArchivo.Imagen) Solo las ve el personal autorizado.</span>
                </label>
                <input asp-for="Fotos" type="file" multiple class="visually-hidden" accept="@ValidadorArchivos.Accept(TipoArchivo.Imagen)" data-archivo />
                <span asp-validation-for="Fotos"></span>
            </div>
        </div>
        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
            <button type="submit" class="btn btn-primary" data-cargando="Guardando...">Guardar evento</button>
            <a asp-action="Index" asp-route-id="@Model.BeneficiarioId" class="btn btn-link">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
