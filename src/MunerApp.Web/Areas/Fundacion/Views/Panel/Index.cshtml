@model PanelViewModel
@{
    ViewData["Title"] = "Panel de " + Model.NombreEsal;
    var hora = Formatos.Local(DateTime.UtcNow).Hour;
    var saludo = hora < 12 ? "Buenos días" : hora < 19 ? "Buenas tardes" : "Buenas noches";
    int Ancho(int n) => Model.GatosEnCasa == 0 ? 0 : (int)Math.Round(100.0 * n / Model.GatosEnCasa);
}
<div class="container-fluid panel-contenido py-4">

    @* ---------- Cabecera con fotos de los gatos ---------- *@
    <section class="panel-hero mb-4 @(Model.FotoPortada is null ? "sin-foto" : "")"
             style="@(Model.FotoPortada is null ? null : $"--portada: url('{Model.FotoPortada}')")">
        <div class="panel-hero-texto">
            <span class="panel-hero-fecha">@Formatos.DiaLargo(Model.Hoy)</span>
            <h1 class="h2 mb-1">@saludo, @Model.NombreUsuario</h1>
            <p class="mb-0">
                @if (Model.ModuloBeneficiarios && Model.GatosEnCasa > 0)
                {
                    <span>Hoy hay <strong>@Model.GatosEnCasa @(Model.GatosEnCasa == 1 ? "gato" : "gatos")</strong> bajo el cuidado de @Model.NombreEsal.</span>
                }
                else
                {
                    <span>Bienvenido al panel de @Model.NombreEsal.</span>
                }
            </p>
            @if (Model.Gatos.Count > 0)
            {
                <div class="panel-hero-gatos mt-3" aria-label="Algunos de los gatos de la fundación">
                    @foreach (var g in Model.Gatos)
                    {
                        <a asp-controller="Beneficiarios" asp-action="Detalle" asp-route-id="@g.Id" title="@g.Nombre">
                            <img src="@Url.Action("Foto", "Beneficiarios", new { id = g.Id })" alt="@g.Nombre" loading="lazy" />
                        </a>
                    }
                    @if (Model.GatosEnCasa > Model.Gatos.Count)
                    {
                        <a class="mas" asp-controller="Beneficiarios" asp-action="Index" title="Ver todos">+@(Model.GatosEnCasa - Model.Gatos.Count)</a>
                    }
                </div>
            }
        </div>
        @if (Model.FotoPortada is null)
        {
            <div class="panel-hero-ilustracion d-none d-md-block"><partial name="_IlustracionGatos" /></div>
        }
    </section>

    @* ---------- Indicadores ---------- *@
    <div class="row g-3 mb-4">
        @if (Model.ModuloBeneficiarios)
        {
            <div class="col-6 col-xl-3">
                <a class="kpi" asp-controller="Beneficiarios" asp-action="Index">
                    <span class="kpi-icono"><i class="bi bi-balloon-heart" aria-hidden="true"></i></span>
                    <span class="kpi-valor">@Model.GatosEnCasa</span>
                    <span class="kpi-titulo">Gatos en la fundación</span>
                    <span class="kpi-detalle">@Model.EnTratamiento en tratamiento · @Model.Adoptables adoptables</span>
                </a>
            </div>
            <div class="col-6 col-xl-3">
                <a class="kpi exito" asp-controller="Beneficiarios" asp-action="Index" asp-route-estado="@EstadoBeneficiario.Adoptado">
                    <span class="kpi-icono"><i class="bi bi-house-heart" aria-hidden="true"></i></span>
                    <span class="kpi-valor">@Model.HogaresEsteMes</span>
                    <span class="kpi-titulo">@(Model.HogaresEsteMes == 1 ? "Encontró hogar" : "Encontraron hogar") este mes</span>
                    <span class="kpi-detalle">@Model.HogaresTotal en total</span>
                </a>
            </div>
        }
        @if (Model.EsAdmin)
        {
            <div class="col-6 col-xl-3">
                <a class="kpi acento" asp-controller="Donaciones" asp-action="Index" asp-route-estado="@EstadoDonacion.Confirmada">
                    <span class="kpi-icono"><i class="bi bi-cash-coin" aria-hidden="true"></i></span>
                    <span class="kpi-valor">@Formatos.Pesos(Model.DonadoEsteMes)</span>
                    <span class="kpi-titulo">Donado este mes</span>
                    <span class="kpi-detalle">@Model.DonacionesEsteMes @(Model.DonacionesEsteMes == 1 ? "donación confirmada" : "donaciones confirmadas")</span>
                </a>
            </div>
            <div class="col-6 col-xl-3">
                <div class="kpi alerta">
                    <span class="kpi-icono"><i class="bi bi-heart-fill" aria-hidden="true"></i></span>
                    <span class="kpi-valor">@Model.PadrinosActivos</span>
                    <span class="kpi-titulo">@(Model.PadrinosActivos == 1 ? "Padrino activo" : "Padrinos activos")</span>
                    <span class="kpi-detalle">@Formatos.Pesos(Model.AporteMensualPadrinos) al mes</span>
                </div>
            </div>
        }
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-7">

            @* ---------- Pendientes ---------- *@
            <section class="mu-card p-4 mb-4">
                <h2 class="h5 mb-1"><i class="bi bi-check2-square me-2 text-acento" aria-hidden="true"></i>Pendientes para hoy</h2>
                @if (Model.Tareas.Count == 0)
                {
                    <div class="text-center py-4">
                        <div class="icono-circulo exito mx-auto mb-3"><i class="bi bi-emoji-smile" aria-hidden="true"></i></div>
                        <p class="fw-semibold mb-1">¡Todo al día!</p>
                        <p class="small text-suave mb-0">No hay nada pendiente por ahora. Los gatos se lo agradecen.</p>
                    </div>
                }
                else
                {
                    <p class="small text-suave mb-3">@Model.Tareas.Count @(Model.Tareas.Count == 1 ? "cosa por atender" : "cosas por atender")</p>
                    <ul class="lista-tareas">
                        @foreach (var t in Model.Tareas)
                        {
                            <li>
                                <a href="@t.Url">
                                    <span class="icono-circulo @(t.Tono == "vacio" ? "" : t.Tono) flex-shrink-0"><i class="bi @t.Icono" aria-hidden="true"></i></span>
                                    <span class="flex-grow-1 min-w-0">
                                        <span class="d-block fw-semibold">@t.Titulo</span>
                                        <span class="d-block small text-suave">@t.Detalle</span>
                                    </span>
                                    <i class="bi bi-chevron-right text-suave" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </section>

            @* ---------- Gatos por estado ---------- *@
            @if (Model.ModuloBeneficiarios && Model.GatosEnCasa > 0)
            {
                <section class="mu-card p-4 mb-4">
                    <h2 class="h5 mb-3"><i class="bi bi-pie-chart me-2 text-acento" aria-hidden="true"></i>¿Cómo están los gatos?</h2>
                    <div class="barra-estados mb-3" role="img"
                         aria-label="@Model.EnLaFundacion en la fundación, @Model.EnTratamiento en tratamiento, @Model.Adoptables adoptables">
                        <span class="seg-fundacion" style="width:@Ancho(Model.EnLaFundacion)%"></span>
                        <span class="seg-tratamiento" style="width:@Ancho(Model.EnTratamiento)%"></span>
                        <span class="seg-adoptable" style="width:@Ancho(Model.Adoptables)%"></span>
                    </div>
                    <div class="d-flex flex-wrap gap-3 small">
                        <a class="leyenda" asp-controller="Beneficiarios" asp-action="Index" asp-route-estado="@EstadoBeneficiario.EnLaFundacion"><span class="punto seg-fundacion"></span>En la fundación <strong>@Model.EnLaFundacion</strong></a>
                        <a class="leyenda" asp-controller="Beneficiarios" asp-action="Index" asp-route-estado="@EstadoBeneficiario.EnTratamiento"><span class="punto seg-tratamiento"></span>En tratamiento <strong>@Model.EnTratamiento</strong></a>
                        <a class="leyenda" asp-controller="Beneficiarios" asp-action="Index" asp-route-estado="@EstadoBeneficiario.Adoptable"><span class="punto seg-adoptable"></span>Adoptables <strong>@Model.Adoptables</strong></a>
                    </div>
                </section>
            }
            else if (Model.ModuloBeneficiarios && Model.EsAdminPrincipal)
            {
                <section class="mu-card p-4 mb-4 text-center">
                    <div class="icono-circulo mx-auto mb-3"><i class="bi bi-balloon-heart" aria-hidden="true"></i></div>
                    <h2 class="h5">Registren su primer gato</h2>
                    <p class="text-suave">Con la hoja de vida de cada gato el tablero empieza a mostrar vacunas, tratamientos y adopciones.</p>
                    <a class="btn btn-primary" asp-controller="Beneficiarios" asp-action="Crear">Registrar gato</a>
                </section>
            }

            @* ---------- Causas ---------- *@
            @if (Model.EsAdmin)
            {
                <section class="mu-card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h5 mb-0"><i class="bi bi-bullseye me-2 text-acento" aria-hidden="true"></i>Causas activas</h2>
                        <a class="small fw-semibold" asp-controller="Causas" asp-action="Index">Ver todas</a>
                    </div>
                    @if (Model.Causas.Count == 0)
                    {
                        <p class="small text-suave mb-0">No hay causas recibiendo donaciones.
                            @if (Model.EsAdminPrincipal)
                            {
                                <a asp-controller="Causas" asp-action="Crear">Crear una causa</a>
                            }
                        </p>
                    }
                    else
                    {
                        <div class="d-grid gap-3">
                            @foreach (var c in Model.Causas)
                            {
                                var pct = Formatos.Porcentaje(c.Recaudado, c.Meta);
                                <div>
                                    <div class="d-flex justify-content-between gap-2 small mb-1">
                                        <span class="fw-semibold text-truncate">@c.Titulo</span>
                                        <span class="text-suave flex-shrink-0">@Formatos.DiasRestantes(c.DiasRestantes)</span>
                                    </div>
                                    <div class="mu-progreso mb-1" role="progressbar" aria-label="Avance de @c.Titulo" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"><span style="width:@pct%"></span></div>
                                    <div class="small text-suave">@Formatos.Pesos(c.Recaudado) de @Formatos.Pesos(c.Meta) · @pct %</div>
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        </div>

        @* ---------- Actividad reciente ---------- *@
        <div class="col-12 col-xl-5">
            <section class="mu-card p-4 mb-4">
                <h2 class="h5 mb-3"><i class="bi bi-clock-history me-2 text-acento" aria-hidden="true"></i>Lo último que pasó</h2>
                @if (Model.Actividad.Count == 0)
                {
                    <p class="small text-suave mb-0">Aquí verán los gatos que llegan, los cambios de estado@(Model.EsAdmin ? ", las donaciones" : "") y los registros de salud.</p>
                }
                else
                {
                    <ul class="lista-actividad">
                        @foreach (var a in Model.Actividad)
                        {
                            <li>
                                <span class="actividad-icono"><i class="bi @a.Icono" aria-hidden="true"></i></span>
                                <span class="flex-grow-1 min-w-0">
                                    @if (a.Url is not null)
                                    {
                                        <a class="d-block text-body" href="@a.Url">@a.Texto</a>
                                    }
                                    else
                                    {
                                        <span class="d-block">@a.Texto</span>
                                    }
                                    <span class="small text-suave">@Formatos.Hace(a.FechaUtc)</span>
                                </span>
                            </li>
                        }
                    </ul>
                }
            </section>

            @if (Model.Slug is not null)
            {
                <a class="mu-card mu-card-hover p-4 d-flex align-items-center gap-3 text-decoration-none text-body" href="/fundaciones/@Model.Slug" target="_blank" rel="noopener">
                    <span class="icono-circulo acento flex-shrink-0"><i class="bi bi-globe2" aria-hidden="true"></i></span>
                    <span class="flex-grow-1">
                        <span class="d-block fw-semibold">Página pública</span>
                        <span class="small text-suave">Así ven los donantes a @Model.NombreEsal</span>
                    </span>
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                </a>
            }
        </div>
    </div>
</div>
