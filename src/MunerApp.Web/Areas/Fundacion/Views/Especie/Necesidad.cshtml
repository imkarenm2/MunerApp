@model NecesidadFormViewModel
@{
    ViewData["Title"] = Model.Id is null ? "Publicar una necesidad" : "Editar necesidad";
}
<div class="container py-4 py-md-5" style="max-width: 680px">
    <a asp-action="Index" class="small fw-semibold text-decoration-none"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Donaciones en especie</a>
    <h1 class="h2 mt-2 mb-1">@ViewData["Title"]</h1>
    <p class="text-suave mb-4">Se mostrará en el perfil de la fundación con una barra de cuánto han recibido.</p>

    <form asp-action="@(Model.Id is null ? "CrearNecesidad" : "EditarNecesidad")" asp-route-id="@Model.Id" method="post" novalidate class="mu-card p-4 p-md-5">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" maxlength="120" placeholder="Ej.: Concentrado para gatitos" />
                <span asp-validation-for="Nombre"></span>
            </div>
            <div class="col-12 col-sm-6">
                <label asp-for="Categoria" class="form-label"></label>
                <select asp-for="Categoria" class="form-select">
                    <option value="">Selecciona…</option>
                    @foreach (var c in Enum.GetValues<CategoriaEspecie>())
                    {
                        <option value="@c" selected="@(Model.Categoria == c)">@Textos.De(c)</option>
                    }
                </select>
                <span asp-validation-for="Categoria"></span>
            </div>
            <div class="col-6 col-sm-3">
                <label asp-for="CantidadMeta" class="form-label">Cantidad</label>
                <input asp-for="CantidadMeta" class="form-control" type="number" min="1" />
                <span asp-validation-for="CantidadMeta"></span>
            </div>
            <div class="col-6 col-sm-3">
                <label asp-for="Unidad" class="form-label"></label>
                <input asp-for="Unidad" class="form-control" maxlength="40" placeholder="bultos de 8 kg" />
                <span asp-validation-for="Unidad"></span>
            </div>
            <div class="col-12">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3" maxlength="500" placeholder="Ej.: preferiblemente marca X, para gatitos de menos de un año"></textarea>
                <span asp-validation-for="Descripcion"></span>
            </div>
            <div class="col-12 form-check ms-1">
                <input asp-for="Urgente" class="form-check-input" />
                <label asp-for="Urgente" class="form-check-label"></label>
            </div>
        </div>
        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
            <button type="submit" class="btn btn-primary">@(Model.Id is null ? "Publicar" : "Guardar cambios")</button>
            <a asp-action="Index" class="btn btn-link">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
