@model SolicitudAdopcionDetalleViewModel
@{
    var s = Model.Solicitud;
    ViewData["Title"] = "Solicitud " + s.Codigo;
    ViewData["Seccion"] = "Adopciones";
    var whatsapp = Formatos.WhatsApp(s.Celular);
    var urlCarne = Url.Action("Carne", new { id = s.Id });

    string SiNo(bool? b) => b switch { true => "Sí", false => "No", _ => "—" };

    var tipos = new List<string>();
    if (s.TieneGato) tipos.Add("Gato");
    if (s.TienePerro) tipos.Add("Perro");
    if (s.TieneOtraMascota) tipos.Add(s.OtraMascota ?? "Otra");
}
<div class="container py-4 py-md-5" style="max-width: 1040px">
    <a asp-action="Index" asp-route-estado="@s.Estado" class="small fw-semibold text-decoration-none"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Solicitudes de adopción</a>
    <div class="d-flex flex-wrap align-items-center gap-2 mt-2 mb-1">
        <h1 class="h2 mb-0">@s.NombreCompleto</h1>
        <partial name="_EstadoSolicitudAdopcion" model="s.Estado" />
    </div>
    <p class="text-suave mb-4">Solicitud @s.Codigo · enviada el @Formatos.FechaHora(s.FechaEnvio!.Value)</p>

    <div class="row g-4">
        <div class="col-12 col-lg-7">
            @* Sección 1: datos personales y de contacto *@
            <section class="mu-card p-4 mb-4" aria-labelledby="tituloDatos">
                <h2 class="h5 mb-3" id="tituloDatos"><i class="bi bi-person me-2 text-principal" aria-hidden="true"></i>Datos personales</h2>
                <dl class="row datos-detalle mb-0">
                    <dt class="col-sm-5">Cédula</dt><dd class="col-sm-7">@s.Cedula</dd>
                    <dt class="col-sm-5">Edad</dt><dd class="col-sm-7">@s.Edad años</dd>
                    <dt class="col-sm-5">Celular</dt>
                    <dd class="col-sm-7">
                        @s.Celular
                        @if (whatsapp is not null)
                        {
                            <a class="ms-2 small" href="@whatsapp" target="_blank" rel="noopener"><i class="bi bi-whatsapp me-1" aria-hidden="true"></i>WhatsApp</a>
                        }
                    </dd>
                    <dt class="col-sm-5">Correo</dt><dd class="col-sm-7 text-break">@Model.Correo</dd>
                    <dt class="col-sm-5">Dirección</dt><dd class="col-sm-7">@s.Direccion, @s.Ciudad</dd>
                    <dt class="col-sm-5">Ocupación</dt>
                    <dd class="col-sm-7">@(s.Ocupacion is null ? "—" : Textos.De(s.Ocupacion.Value))@(s.DetalleOcupacion is null ? "" : ": " + s.DetalleOcupacion)</dd>
                    <dt class="col-sm-5">Referencia personal</dt>
                    <dd class="col-sm-7">@s.ReferenciaNombre (@s.ReferenciaRelacion)<div class="small text-suave">@s.ReferenciaCelular</div></dd>
                </dl>
            </section>

            @* Sección 2: mascotas *@
            <section class="mu-card p-4 mb-4" aria-labelledby="tituloMascotas">
                <h2 class="h5 mb-3" id="tituloMascotas"><i class="bi bi-heart me-2 text-principal" aria-hidden="true"></i>Experiencia con mascotas</h2>
                <dl class="row datos-detalle mb-0">
                    <dt class="col-sm-5">Mascotas</dt><dd class="col-sm-7">@(s.Mascotas is null ? "—" : Textos.De(s.Mascotas.Value))</dd>
                    @if (tipos.Count > 0)
                    {
                        <dt class="col-sm-5">Tiene</dt><dd class="col-sm-7">@string.Join(", ", tipos)</dd>
                    }
                    @if (s.TieneGato)
                    {
                        <dt class="col-sm-5">Su gato usa arenero</dt><dd class="col-sm-7">@SiNo(s.GatoUsaArenero)</dd>
                        <dt class="col-sm-5">Esterilizados</dt><dd class="col-sm-7">@(s.GatoEsterilizacion is null ? "—" : Textos.De(s.GatoEsterilizacion.Value))</dd>
                        <dt class="col-sm-5">Vacunas</dt>
                        <dd class="col-sm-7">
                            @(s.GatoVacunas is null ? "—" : Textos.De(s.GatoVacunas.Value))
                            @if (s.CarneVacunasRuta is not null)
                            {
                                <div><a class="small" href="@urlCarne" target="_blank" rel="noopener"><i class="bi bi-paperclip me-1" aria-hidden="true"></i>Ver carné de vacunas</a></div>
                            }
                        </dd>
                    }
                    @if (s.TienePerro)
                    {
                        <dt class="col-sm-5">Su perro con gatos</dt><dd class="col-sm-7">@(s.PerroSociabilidad is null ? "—" : Textos.De(s.PerroSociabilidad.Value))</dd>
                    }
                    @if (!string.IsNullOrEmpty(s.QuePasoMascota))
                    {
                        <dt class="col-sm-5">Qué pasó con su mascota</dt><dd class="col-sm-7 fw-normal">@s.QuePasoMascota</dd>
                    }
                </dl>
            </section>

            @* Sección 3: hogar y compromisos *@
            <section class="mu-card p-4" aria-labelledby="tituloHogar">
                <h2 class="h5 mb-3" id="tituloHogar"><i class="bi bi-house me-2 text-principal" aria-hidden="true"></i>Hogar y compromisos</h2>
                <dl class="row datos-detalle mb-0">
                    <dt class="col-sm-5">Vivienda</dt>
                    <dd class="col-sm-7">@(s.TipoVivienda is null ? "—" : Textos.De(s.TipoVivienda.Value)) · @(s.TenenciaVivienda is null ? "—" : Textos.De(s.TenenciaVivienda.Value))</dd>
                    @if (s.TenenciaVivienda == TenenciaVivienda.Arrendada)
                    {
                        <dt class="col-sm-5">Arrendador permite mascotas</dt><dd class="col-sm-7">@SiNo(s.ArrendadorPermiteMascotas)</dd>
                    }
                    <dt class="col-sm-5">Personas en el hogar</dt><dd class="col-sm-7">@s.Convivientes</dd>
                    <dt class="col-sm-5">Todas de acuerdo</dt><dd class="col-sm-7">@SiNo(s.ConvivientesDeAcuerdo)</dd>
                    <dt class="col-sm-5">Niños en casa</dt>
                    <dd class="col-sm-7">@SiNo(s.NinosEnCasa)@(s.NinosEnCasa == true ? " · han interactuado con mascotas: " + SiNo(s.NinosInteractuanMascotas).ToLowerInvariant() : "")</dd>
                    <dt class="col-sm-5">Embarazo en el hogar</dt><dd class="col-sm-7">@SiNo(s.EmbarazoEnHogar)</dd>
                    <dt class="col-sm-5">Puede cubrir los costos</dt><dd class="col-sm-7">@SiNo(s.PuedeCubrirCostos)</dd>
                    <dt class="col-sm-5">Acepta visita de seguimiento</dt><dd class="col-sm-7">@SiNo(s.AceptaVisita)</dd>
                    <dt class="col-sm-5">Aceptaciones</dt>
                    <dd class="col-sm-7">
                        <ul class="lista-check small mb-0">
                            <li>Requisito (aporte y huacal)</li>
                            <li>Contrato de adopción</li>
                            <li>Tratamiento de datos@(s.FechaAutorizacionDatos is DateTime fa ? " · " + Formatos.FechaHora(fa) : "")</li>
                        </ul>
                    </dd>
                </dl>
            </section>
        </div>

        <div class="col-12 col-lg-5">
            <div class="perfil-lateral">
                @if (s.Estado == EstadoSolicitudAdopcion.Recibida)
                {
                    <div class="mu-card p-4">
                        <h2 class="h6 fw-bold mb-2">¿Esta persona puede seguir al siguiente paso?</h2>
                        <p class="small text-suave">Si la apruebas, podrás agendarle la cita presencial para que conozca a los gatos y se formalice la adopción.</p>

                        <form asp-action="Aprobar" asp-route-id="@s.Id" method="post" class="mb-3"
                              data-confirmar="La persona recibirá una notificación de que su solicitud fue aprobada y quedará pendiente de agendar la cita."
                              data-confirmar-titulo="¿Aprobar la solicitud de @s.NombreCompleto?" data-confirmar-boton="Sí, aprobar">
                            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-house-check me-2" aria-hidden="true"></i>Aprobar para cita</button>
                        </form>

                        <details class="rechazo">
                            <summary class="btn btn-link text-danger p-0">No cumple: rechazar solicitud</summary>
                            <form asp-action="Rechazar" asp-route-id="@s.Id" method="post" class="mt-3"
                                  data-confirmar="La persona verá el motivo que escribiste. Esta acción no se puede deshacer."
                                  data-confirmar-titulo="¿Rechazar la solicitud?" data-confirmar-boton="Sí, rechazar" data-confirmar-tipo="peligro">
                                <label for="motivo" class="form-label">Motivo (lo verá la persona)</label>
                                <textarea id="motivo" name="motivo" class="form-control" rows="3" maxlength="300" minlength="10" required
                                          placeholder="Ej.: por ahora buscamos hogares donde el arrendador permita mascotas."></textarea>
                                <button type="submit" class="btn btn-outline-danger mt-2">Rechazar solicitud</button>
                            </form>
                        </details>
                    </div>
                }
                else
                {
                    <div class="mu-card p-4">
                        <h2 class="h6 fw-bold mb-2">Revisión</h2>
                        <dl class="row datos-detalle mb-0">
                            <dt class="col-5">Resultado</dt><dd class="col-7">@Textos.De(s.Estado)</dd>
                            @if (s.FechaRevision is DateTime rev)
                            {
                                <dt class="col-5">Revisada</dt><dd class="col-7">@Formatos.FechaHora(rev)@(Model.RevisadoPor is null ? "" : " por " + Model.RevisadoPor)</dd>
                            }
                            @if (!string.IsNullOrEmpty(s.MotivoRechazo))
                            {
                                <dt class="col-5">Motivo</dt><dd class="col-7 fw-normal">@s.MotivoRechazo</dd>
                            }
                        </dl>
                    </div>
                }

                @if (s.CarneVacunasRuta is not null)
                {
                    <div class="mu-card p-3 mt-3">
                        <div class="d-flex align-items-center justify-content-between mb-2 px-1">
                            <h2 class="h6 fw-bold mb-0">Carné de vacunas</h2>
                            <a class="small" href="@urlCarne" target="_blank" rel="noopener">Abrir en otra pestaña <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                        </div>
                        @if (Model.CarneEsPdf)
                        {
                            <object class="visor-soporte" data="@urlCarne" type="application/pdf" aria-label="Carné de vacunas en PDF">
                                <p class="p-3 small">No se pudo mostrar el PDF aquí. <a href="@urlCarne" target="_blank" rel="noopener">Ábrelo en otra pestaña</a>.</p>
                            </object>
                        }
                        else
                        {
                            <img class="visor-soporte img-soporte" src="@urlCarne" alt="Carné de vacunas del gato del solicitante" />
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
