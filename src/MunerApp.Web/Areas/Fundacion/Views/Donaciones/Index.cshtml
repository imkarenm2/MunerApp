@model DonacionesEsalViewModel
@{
    ViewData["Title"] = "Donaciones";
    ViewData["Seccion"] = "Donaciones";
    int Conteo(EstadoDonacion e) => Model.Conteos.TryGetValue(e, out var c) ? c : 0;
    var pestanas = new[]
    {
        (Estado: EstadoDonacion.Pendiente, Texto: "Por confirmar", Icono: "bi-hourglass-split"),
        (Estado: EstadoDonacion.Confirmada, Texto: "Confirmadas", Icono: "bi-check-circle"),
        (Estado: EstadoDonacion.Rechazada, Texto: "Rechazadas", Icono: "bi-x-circle")
    };
}
<div class="container py-4 py-md-5">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-3">
        <div>
            <h1 class="h2 mb-1">Donaciones</h1>
            <p class="text-suave mb-0">Revisa en tu banco que el dinero llegó y confirma cada donación para que el donante reciba su comprobante.</p>
        </div>
        <div class="mu-card px-4 py-3 text-end">
            <div class="small text-suave">Total confirmado</div>
            <div class="h4 fw-bold text-principal mb-0">@Formatos.Pesos(Model.TotalConfirmado)</div>
        </div>
    </div>

    <partial name="_NavFundacion" />

    <ul class="nav nav-tabs pestanas mb-3" role="tablist">
        @foreach (var p in pestanas)
        {
            <li class="nav-item">
                <a class="nav-link @(Model.Estado == p.Estado ? "active" : "")" asp-action="Index" asp-route-estado="@p.Estado"
                   aria-current="@(Model.Estado == p.Estado ? "page" : null)">
                    <i class="bi @p.Icono me-1" aria-hidden="true"></i>@p.Texto
                    <span class="badge rounded-pill @(p.Estado == EstadoDonacion.Pendiente && Conteo(p.Estado) > 0 ? "text-bg-warning" : "text-bg-light") ms-1">@Conteo(p.Estado)</span>
                </a>
            </li>
        }
    </ul>

    @if (Model.Donaciones.Count == 0)
    {
        <div class="estado-vacio">
            <div class="icono-circulo @(Model.Estado == EstadoDonacion.Pendiente ? "exito" : "") mb-3">
                <i class="bi @(Model.Estado == EstadoDonacion.Pendiente ? "bi-check2-all" : "bi-inbox")" aria-hidden="true"></i>
            </div>
            <h2 class="h5">@(Model.Estado == EstadoDonacion.Pendiente ? "¡Todo al día! No hay donaciones por confirmar." : "No hay donaciones en esta lista.")</h2>
        </div>
    }
    else
    {
        <div class="mu-card overflow-hidden">
            <div class="table-responsive">
                <table class="table tabla-mu align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Donante</th>
                            <th scope="col">Código</th>
                            <th scope="col">Transferencia</th>
                            <th scope="col" class="text-end">Valor</th>
                            <th scope="col" class="text-end"><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Donaciones)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@d.Donante</div>
                                    <div class="small text-suave">@d.CorreoDonante</div>
                                </td>
                                <td class="small">@d.Codigo<div class="text-suave">Reportada @Formatos.Hace(d.FechaReporte)</div>
                                    @if (d.Apadrinado is not null)
                                    {
                                        <span class="mu-badge acento mt-1"><i class="bi bi-balloon-heart" aria-hidden="true"></i>Apadrinamiento de @d.Apadrinado</span>
                                    }
                                </td>
                                <td class="small">@Formatos.Fecha(d.FechaTransferencia)</td>
                                <td class="text-end fw-bold">@Formatos.Pesos(d.Valor)</td>
                                <td class="text-end">
                                    <a class="btn btn-sm @(d.Estado == EstadoDonacion.Pendiente ? "btn-primary" : "btn-suave")" asp-action="Detalle" asp-route-id="@d.Id">
                                        @(d.Estado == EstadoDonacion.Pendiente ? "Revisar" : "Ver")
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
