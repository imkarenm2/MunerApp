@model MedicamentosIndexViewModel
@{
    ViewData["Title"] = "Medicamentos e insumos";
    ViewData["Seccion"] = "Medicamentos";
    var hoy = Formatos.Local(DateTime.UtcNow).Date;
}
<div class="container py-4 py-md-5">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-3">
        <div>
            <h1 class="h2 mb-1">Medicamentos e insumos</h1>
            <p class="text-suave mb-0">Inventario clínico de la fundación: qué hay disponible y hasta cuándo sirve.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (User.IsInRole(Roles.AdministradorESAL) && User.HasClaim(MunerAppClaims.Perfil, Perfiles.Principal))
            {
                @* HU-039: plazo de las alertas *@
                <a class="btn btn-outline-primary" asp-action="Alertas"><i class="bi bi-bell me-1" aria-hidden="true"></i>Alertas</a>
            }
            @if (User.IsInRole(Roles.AdministradorESAL))
            {
                @* HU-040: reporte con filtros y PDF *@
                <a class="btn btn-outline-primary" asp-action="Reporte"><i class="bi bi-clipboard-data me-1" aria-hidden="true"></i>Reporte</a>
            }
            <a class="btn btn-primary" asp-action="Crear"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Registrar medicamento</a>
        </div>
    </div>

    <partial name="_NavFundacion" />

    <form asp-action="Index" method="get" class="buscador mb-3" role="search" style="max-width: 420px">
        <label for="q" class="visually-hidden">Buscar medicamento</label>
        <div class="input-icono">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input id="q" name="q" value="@Model.Busqueda" class="form-control" placeholder="Nombre comercial o principio activo" />
        </div>
    </form>

    @if (Model.Medicamentos.Count == 0)
    {
        <div class="estado-vacio">
            <div class="icono-circulo mb-3"><i class="bi bi-capsule" aria-hidden="true"></i></div>
            @if (string.IsNullOrEmpty(Model.Busqueda))
            {
                <h2 class="h5">Aún no hay medicamentos registrados</h2>
                <p class="text-suave">Registra los medicamentos e insumos para saber qué hay disponible y que no falten.</p>
                <a class="btn btn-primary" asp-action="Crear">Registrar el primero</a>
            }
            else
            {
                <h2 class="h5 mb-0">No hay medicamentos que coincidan con "@Model.Busqueda".</h2>
            }
        </div>
    }
    else
    {
        <div class="mu-card overflow-hidden">
            <div class="table-responsive">
                <table class="table tabla-mu align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Medicamento</th>
                            <th scope="col">Vía</th>
                            <th scope="col">Vence</th>
                            <th scope="col" class="text-end">Disponible</th>
                            <th scope="col" class="text-end"><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Medicamentos)
                        {
                            var vencido = m.FechaVencimiento.Date < hoy;
                            var stockBajo = m.CantidadMinima is decimal min && m.Cantidad <= min;
                            var faltan = (m.FechaVencimiento.Date - hoy).Days;
                            var porVencer = !vencido && faltan <= Model.DiasAviso;
                            <tr>
                                <td>
                                    <div class="fw-semibold">@m.NombreComercial</div>
                                    <div class="small text-suave">@m.PrincipioActivo</div>
                                </td>
                                <td class="small">@Textos.De(m.Via)</td>
                                <td class="small">
                                    @Formatos.Fecha(m.FechaVencimiento)
                                    @if (vencido)
                                    {
                                        <span class="mu-badge error d-table mt-1"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i>Vencido</span>
                                    }
                                    else if (porVencer)
                                    {
                                        <span class="mu-badge alerta d-table mt-1"><i class="bi bi-hourglass-split" aria-hidden="true"></i>@(faltan == 0 ? "Vence hoy" : faltan == 1 ? "Vence mañana" : $"Vence en {faltan} días")</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold">@Formatos.Cantidad(m.Cantidad)</span> <span class="small text-suave">@Textos.UnidadDe(m.Presentacion)</span>
                                    @if (stockBajo)
                                    {
                                        <span class="mu-badge alerta d-table ms-auto mt-1"><i class="bi bi-arrow-down-circle" aria-hidden="true"></i>Stock bajo</span>
                                    }
                                </td>
                                <td class="text-end"><a class="btn btn-sm btn-suave" asp-action="Detalle" asp-route-id="@m.Id">Ver</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
