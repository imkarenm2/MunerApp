@model NovedadFormViewModel
@{
    ViewData["Title"] = "Publicar novedad";
    ViewData["Seccion"] = "Beneficiarios";
    var max = MunerApp.Domain.Entities.NovedadBeneficiario.MaxFotos;
}
<div class="container py-4 py-md-5" style="max-width: 720px">
    <a asp-action="Index" asp-route-id="@Model.BeneficiarioId" class="small fw-semibold text-decoration-none"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Novedades de @Model.NombreBeneficiario</a>
    <h1 class="h2 mt-2 mb-1">Publicar novedad de @Model.NombreBeneficiario</h1>
    <p class="text-suave mb-4">
        @(Model.PadrinosActivos switch
        {
            0 => "Todavía no tiene padrinos activos: la verán quienes lo apadrinen.",
            1 => "Su padrino recibirá una notificación y la verá en Mis apadrinamientos.",
            _ => $"Sus {Model.PadrinosActivos} padrinos recibirán una notificación y la verán en Mis apadrinamientos."
        })
    </p>

    <form asp-action="Crear" asp-route-id="@Model.BeneficiarioId" method="post" enctype="multipart/form-data" novalidate class="mu-card p-4 p-md-5">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Texto" class="form-label"></label>
                <textarea asp-for="Texto" class="form-control" rows="5" maxlength="2000"
                          placeholder="Ej.: Tom ya terminó el tratamiento de los ojos y está jugando con los demás gatos. ¡Gracias por acompañarlo!"></textarea>
                <span asp-validation-for="Texto"></span>
            </div>
            <div class="col-12">
                <label class="form-label" for="Fotos">Fotos (opcional)</label>
                <label class="zona-archivo" for="Fotos">
                    <i class="bi bi-images" aria-hidden="true"></i>
                    <span class="fw-semibold" data-nombre-archivo>Selecciona hasta @max fotos</span>
                    <span class="small text-suave">@ValidadorArchivos.Ayuda(TipoArchivo.Imagen) Solo las ven la fundación y los padrinos de @Model.NombreBeneficiario.</span>
                </label>
                <input asp-for="Fotos" type="file" multiple class="visually-hidden" accept="@ValidadorArchivos.Accept(TipoArchivo.Imagen)" data-archivo />
                <span asp-validation-for="Fotos"></span>
            </div>
        </div>
        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
            <button type="submit" class="btn btn-primary" data-cargando="Publicando..."><i class="bi bi-megaphone me-1" aria-hidden="true"></i>Publicar</button>
            <a asp-action="Index" asp-route-id="@Model.BeneficiarioId" class="btn btn-link">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
