@model PublicacionFormViewModel
@{
    ViewData["Title"] = "Nueva publicación";
    ViewData["Seccion"] = "Boletin";
}
<div class="container py-4 py-md-5" style="max-width: 820px">
    <a asp-action="Index" class="small fw-semibold text-decoration-none"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Boletín</a>
    <h1 class="h2 mt-2 mb-1">Nueva publicación</h1>
    <p class="text-suave mb-4">Guárdala como borrador para revisarla, o publícala de una vez en el boletín de la fundación.</p>

    <form asp-action="Crear" method="post" enctype="multipart/form-data" novalidate class="mu-card p-4 p-md-5">
        <partial name="_Formulario" model="Model" />
        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
            <button type="submit" name="publicar" value="true" class="btn btn-primary" data-cargando="Publicando..."><i class="bi bi-broadcast me-1" aria-hidden="true"></i>Publicar</button>
            <button type="submit" name="publicar" value="false" class="btn btn-suave" data-cargando="Guardando...">Guardar borrador</button>
            <a asp-action="Index" class="btn btn-link">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
