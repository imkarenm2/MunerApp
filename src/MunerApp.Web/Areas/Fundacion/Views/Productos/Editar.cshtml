@model ProductoFormViewModel
@{
    ViewData["Title"] = "Editar producto";
    ViewData["Seccion"] = "Tienda";
}
<div class="container py-4 py-md-5" style="max-width: 760px">
    <a asp-action="Index" class="small fw-semibold text-decoration-none"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Tienda</a>
    <h1 class="h2 mt-2 mb-1">Editar producto</h1>
    <p class="text-suave mb-4">Los cambios se ven de inmediato en la tienda.</p>

    <form asp-action="Editar" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate class="mu-card p-4 p-md-5">
        <partial name="_Formulario" model="Model" />
        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
            <button type="submit" class="btn btn-primary" data-cargando="Guardando...">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-link">Cancelar</a>
        </div>
    </form>

    @if (Model.Movimientos.Count > 0)
    {
        <section class="mu-card p-4 mt-4" aria-labelledby="titulo-inventario">
            <h2 id="titulo-inventario" class="h5 mb-1">Movimientos del inventario</h2>
            <p class="small text-suave mb-3">Los últimos @Model.Movimientos.Count. Se registran solos al pagar o cancelar pedidos y al cambiar las unidades.</p>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Fecha</th>
                            <th scope="col">Movimiento</th>
                            <th scope="col" class="text-end">Unidades</th>
                            <th scope="col" class="text-end">Quedan</th>
                            <th scope="col">Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Movimientos)
                        {
                            <tr>
                                <td class="text-nowrap small">@Formatos.FechaHora(m.Fecha)</td>
                                <td>@Textos.De(m.Tipo)</td>
                                <td class="text-end fw-semibold @(m.Cantidad < 0 ? "text-danger" : "text-success")">@(m.Cantidad > 0 ? "+" : "")@m.Cantidad</td>
                                <td class="text-end">@m.CantidadResultante</td>
                                <td class="small text-suave">@m.Nota@(m.RegistradoPor is null ? "" : $" · {m.RegistradoPor}")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@* Formularios para quitar cada foto: van fuera del formulario principal para que Enter no los dispare *@
@foreach (var f in Model.FotosActuales)
{
    <form id="quitar-foto-@f.Id" asp-action="EliminarFoto" asp-route-id="@Model.Id" asp-route-fotoId="@f.Id" method="post"
          data-confirmar="La foto dejará de verse en la tienda." data-confirmar-titulo="¿Quitar esta foto?" data-confirmar-boton="Sí, quitar" data-confirmar-tipo="peligro"></form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
