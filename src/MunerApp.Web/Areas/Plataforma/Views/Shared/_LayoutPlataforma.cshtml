@* Layout del panel del superadministrador: mismo estilo que el panel de las fundaciones. *@
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Panel"] = true;
}
@section Estilos {
    @await RenderSectionAsync("Estilos", required: false)
}
<partial name="_NavPlataforma" />

<div class="panel-principal">
    <partial name="_Alertas" />
    @RenderBody()
</div>
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
