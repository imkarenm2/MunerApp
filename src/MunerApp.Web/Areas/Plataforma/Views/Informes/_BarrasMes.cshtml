@model (IReadOnlyList<BarraMes> Barras, string Unidad)
@{
    var max = Model.Barras.Count == 0 ? 0 : Model.Barras.Max(b => b.Valor);
}
@* Barras por mes: una sola serie, un solo color. El valor exacto aparece al pasar el mouse y en la tabla de abajo. *@
<div class="barras-mes" role="img" aria-label="@string.Join(", ", Model.Barras.Select(b => $"{b.Mes}: {Formatos.Pesos(b.Valor)}"))">
    @foreach (var b in Model.Barras)
    {
        var alto = max == 0 ? 0 : (int)Math.Round(100 * b.Valor / max);
        <div class="barras-mes-col" title="@b.Mes: @Formatos.Pesos(b.Valor) · @b.Cantidad @Model.Unidad">
            <div class="barras-mes-area"><span class="barras-mes-barra" style="height:@(b.Valor > 0 ? Math.Max(alto, 2) : 0)%"></span></div>
            <span class="barras-mes-etiqueta">@b.Mes</span>
        </div>
    }
</div>
<details class="mt-3 small">
    <summary class="text-suave">Ver como tabla</summary>
    <table class="table table-sm mt-2 mb-0">
        <thead><tr><th>Mes</th><th class="text-end">Valor</th><th class="text-end">Cantidad</th></tr></thead>
        <tbody>
            @foreach (var b in Model.Barras)
            {
                <tr><td>@b.Mes</td><td class="text-end">@Formatos.Pesos(b.Valor)</td><td class="text-end">@b.Cantidad</td></tr>
            }
        </tbody>
    </table>
</details>
