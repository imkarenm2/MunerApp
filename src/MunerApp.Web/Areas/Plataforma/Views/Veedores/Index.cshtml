@model List<VeedorItem>
@{
    ViewData["Title"] = "Veedores";
}
<div class="container-fluid panel-contenido py-4">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Veeduría ciudadana</h1>
            <p class="text-suave mb-0" style="max-width: 720px">Las veedurías vigilan que lo que reciben las fundaciones llegue a donde se dijo. Sus cuentas solo consultan: ven donaciones, causas, rendición de cuentas y donaciones en especie, sin datos personales de los donantes.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-suave" asp-area="Veeduria" asp-controller="Consulta" asp-action="Index"><i class="bi bi-eye me-1" aria-hidden="true"></i>Ver lo que ven</a>
            <a class="btn btn-primary" asp-action="Crear"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Dar acceso a un veedor</a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="estado-vacio">
            <div class="icono-circulo mb-3"><i class="bi bi-binoculars" aria-hidden="true"></i></div>
            <h2 class="h5">Aún no hay veedores</h2>
            <p class="text-suave">Cuando una veeduría ciudadana pida acceso, créale su cuenta aquí.</p>
        </div>
    }
    else
    {
        <div class="mu-card overflow-hidden">
            <div class="table-responsive">
                <table class="table tabla-mu align-middle mb-0">
                    <thead><tr><th scope="col">Veedor</th><th scope="col">Veeduría</th><th scope="col">Desde</th><th scope="col">Estado</th><th scope="col"></th></tr></thead>
                    <tbody>
                        @foreach (var v in Model)
                        {
                            <tr>
                                <td><span class="fw-semibold">@v.Nombre</span><div class="small text-suave">@v.Correo</div></td>
                                <td>@(v.Organizacion ?? "—")</td>
                                <td class="small">@Formatos.FechaCorta(v.FechaRegistro)</td>
                                <td><span class="mu-badge @(v.Activo ? "exito" : "")">@(v.Activo ? "Activo" : "Inactivo")</span></td>
                                <td class="text-end">
                                    <form asp-action="CambiarEstado" asp-route-id="@v.Id" method="post"
                                          data-confirmar="@(v.Activo ? "Ya no podrá entrar a la veeduría." : "Podrá volver a entrar a la veeduría.")"
                                          data-confirmar-titulo="@(v.Activo ? "¿Desactivar el acceso?" : "¿Activar el acceso?")" data-confirmar-boton="Sí">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">@(v.Activo ? "Desactivar" : "Activar")</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
