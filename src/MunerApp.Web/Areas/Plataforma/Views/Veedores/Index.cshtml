@model List<VeedorItem>
@{
    ViewData["Title"] = "Veedores";
}
<div class="container-fluid panel-contenido py-4">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Veeduría ciudadana</h1>
            <p class="text-suave mb-0" style="max-width: 720px">La veeduría pública la ve cualquiera, sin cuenta. Ser veedor es un permiso extra sobre una cuenta normal: agrega el registro de cambios de cada fundación (sin datos personales de donantes) y cada consulta queda anotada. Un veedor puede seguir donando.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-suave" asp-area="Veeduria" asp-controller="Consulta" asp-action="Index"><i class="bi bi-eye me-1" aria-hidden="true"></i>Ver la veeduría pública</a>
            <a class="btn btn-primary" asp-action="Crear"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Dar permiso de veedor</a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="estado-vacio">
            <div class="icono-circulo mb-3"><i class="bi bi-binoculars" aria-hidden="true"></i></div>
            <h2 class="h5">Aún no hay veedores</h2>
            <p class="text-suave">Cuando una veeduría ciudadana pida acceso, dale el permiso con su correo.</p>
        </div>
    }
    else
    {
        <div class="mu-card overflow-hidden">
            <div class="table-responsive">
                <table class="table tabla-mu align-middle mb-0">
                    <thead><tr><th scope="col">Veedor</th><th scope="col">Veeduría</th><th scope="col">Cuenta desde</th><th scope="col">Cuenta</th><th scope="col"></th></tr></thead>
                    <tbody>
                        @foreach (var v in Model)
                        {
                            <tr>
                                <td><span class="fw-semibold">@v.Nombre</span><div class="small text-suave">@v.Correo</div></td>
                                <td>@(v.Organizacion ?? "—")</td>
                                <td class="small">@Formatos.FechaCorta(v.FechaRegistro)</td>
                                <td><span class="mu-badge @(v.Activo ? "exito" : "")">@(v.Activo ? "Activa" : "Desactivada")</span></td>
                                <td class="text-end">
                                    <form asp-action="QuitarPermiso" asp-route-id="@v.Id" method="post"
                                          data-confirmar="Su cuenta sigue activa, pero ya no verá el registro de cambios."
                                          data-confirmar-titulo="¿Quitar el permiso de veedor?" data-confirmar-boton="Sí, quitar">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Quitar permiso</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
