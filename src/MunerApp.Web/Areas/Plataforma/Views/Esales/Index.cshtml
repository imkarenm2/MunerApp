@model List<EsalListaItem>
@{
    ViewData["Title"] = "Fundaciones";
}
<div class="container py-4 py-md-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
        <div>
            <span class="mu-badge mb-2"><i class="bi bi-shield-lock" aria-hidden="true"></i>Panel de plataforma</span>
            <h1 class="h2 mb-1">Fundaciones</h1>
            <p class="text-suave mb-0">Registra fundaciones después del levantamiento de necesidades y activa sus módulos.</p>
        </div>
        <a class="btn btn-primary" asp-action="Crear"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Registrar fundación</a>
    </div>

    @if (!Model.Any())
    {
        <div class="mu-card">
            <div class="estado-vacio my-0">
                <div class="icono-circulo"><i class="bi bi-buildings" aria-hidden="true"></i></div>
                <h2 class="h4">Aún no hay fundaciones</h2>
                <p class="text-suave mb-4">Registra la primera fundación con los datos del levantamiento.</p>
                <a class="btn btn-primary" asp-action="Crear">Registrar fundación</a>
            </div>
        </div>
    }
    else
    {
        <div class="mu-card overflow-hidden">
            <div class="table-responsive">
                <table class="table tabla-mu align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Fundación</th>
                            <th scope="col">NIT</th>
                            <th scope="col" class="text-center">Módulos</th>
                            <th scope="col" class="text-center">Usuarios</th>
                            <th scope="col">Estado</th>
                            <th scope="col" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">
                                        @e.Nombre
                                        @if (e.Activa && e.Slug is not null)
                                        {
                                            <a class="small ms-1" href="/fundaciones/@e.Slug" target="_blank" rel="noopener" title="Ver perfil público" aria-label="Ver perfil público de @e.Nombre"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                                        }
                                    </div>
                                    <div class="small text-suave">@e.TipoEntidad · desde @e.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>@e.Nit</td>
                                <td class="text-center">@e.ModulosActivos</td>
                                <td class="text-center">@e.Usuarios</td>
                                <td>
                                    @if (e.Activa)
                                    {
                                        <span class="mu-badge exito"><i class="bi bi-check-circle" aria-hidden="true"></i>Activa</span>
                                    }
                                    else
                                    {
                                        <span class="mu-badge error"><i class="bi bi-pause-circle" aria-hidden="true"></i>Inactiva</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a class="btn btn-sm btn-suave" asp-action="Modulos" asp-route-id="@e.Id" title="Módulos"><i class="bi bi-puzzle" aria-hidden="true"></i><span class="d-none d-lg-inline ms-1">Módulos</span></a>
                                        <a class="btn btn-sm btn-suave" asp-action="Editar" asp-route-id="@e.Id" title="Editar"><i class="bi bi-pencil" aria-hidden="true"></i><span class="d-none d-lg-inline ms-1">Editar</span></a>
                                        <form asp-action="CambiarEstado" asp-route-id="@e.Id" method="post" class="d-inline"
                                              data-confirmar="@(e.Activa ? $"{e.Nombre} dejará de ser visible para los donantes y sus usuarios no podrán ingresar. Puedes volver a activarla cuando quieras." : $"{e.Nombre} volverá a ser visible y sus usuarios podrán ingresar.")"
                                              data-confirmar-titulo="@(e.Activa ? "¿Desactivar la fundación?" : "¿Activar la fundación?")"
                                              data-confirmar-boton="@(e.Activa ? "Sí, desactivar" : "Sí, activar")"
                                              data-confirmar-tipo="@(e.Activa ? "peligro" : "normal")">
                                            <button type="submit" class="btn btn-sm @(e.Activa ? "btn-outline-danger" : "btn-outline-primary")"
                                                    title="@(e.Activa ? "Desactivar" : "Activar")">
                                                <i class="bi @(e.Activa ? "bi-pause" : "bi-play")" aria-hidden="true"></i>
                                                <span class="d-none d-lg-inline ms-1">@(e.Activa ? "Desactivar" : "Activar")</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
