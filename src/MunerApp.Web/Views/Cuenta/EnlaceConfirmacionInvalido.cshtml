@{
    ViewData["Title"] = "Enlace no válido";
}
<div class="container">
    <div class="estado-vacio">
        <div class="icono-circulo alerta"><i class="bi bi-link-45deg" aria-hidden="true"></i></div>
        <h1 class="h3">Este enlace de confirmación ya no es válido</h1>
        <p class="text-suave mb-4">Puede que haya vencido (dura 1 hora). Intenta iniciar sesión y te ofreceremos enviarte uno nuevo.</p>
        <a class="btn btn-primary" asp-area="" asp-controller="Cuenta" asp-action="IniciarSesion">Ir a iniciar sesión</a>
    </div>
</div>
