@model InicioSesionViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}
<div class="auth-contenedor">
    <div class="container">
        <div class="mu-card auth-card">
            <partial name="_AuthLateral" />
            <div class="auth-formulario">
                <h1 class="h3 mb-1">¡Hola de nuevo!</h1>
                <p class="text-suave mb-4">Inicia sesión para seguir apoyando.</p>

                @if (!string.IsNullOrEmpty(ViewData["ReturnUrl"] as string))
                {
                    <div class="alert alert-info small py-2">
                        <i class="bi bi-person-lock" aria-hidden="true"></i>
                        <div>Para continuar necesitas una cuenta. Inicia sesión o créala en un minuto: te llevaremos de vuelta a donde estabas.</div>
                    </div>
                }

                <partial name="_BotonGoogle" />

                <form asp-action="IniciarSesion" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-icono">
                            <i class="bi bi-envelope" aria-hidden="true"></i>
                            <input asp-for="Email" class="form-control" autocomplete="email" placeholder="tucorreo@ejemplo.com" />
                        </div>
                        <span asp-validation-for="Email"></span>
                    </div>

                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <label asp-for="Contrasena" class="form-label"></label>
                            <a asp-action="OlvideContrasena" class="small">¿Olvidaste tu contraseña?</a>
                        </div>
                        <div class="input-icono con-boton">
                            <i class="bi bi-lock" aria-hidden="true"></i>
                            <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
                            <button type="button" class="btn-ver-clave" data-ver-clave="Contrasena" aria-label="Mostrar contraseña">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Contrasena"></span>
                    </div>

                    <div class="form-check my-3">
                        <input asp-for="Recordarme" class="form-check-input" />
                        <label asp-for="Recordarme" class="form-check-label">Mantener mi sesión iniciada</label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100" data-cargando="Iniciando sesión...">Iniciar sesión</button>
                </form>

                <p class="mt-4 mb-0 text-center text-suave">
                    ¿Aún no tienes cuenta? <a asp-action="Registrar" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="fw-semibold">Crea una aquí</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
