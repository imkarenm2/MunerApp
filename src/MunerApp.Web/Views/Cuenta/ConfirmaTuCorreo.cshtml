@{
    ViewData["Title"] = "Confirma tu correo";
    var correo = TempData["CorreoConfirmacion"] as string;
}
<div class="auth-contenedor">
    <div class="container">
        <div class="mu-card mx-auto p-4 p-md-5 text-center" style="max-width: 500px">
            <div class="icono-circulo exito mb-3 mx-auto"><i class="bi bi-envelope-check" aria-hidden="true"></i></div>
            <h1 class="h3 mb-2">Confirma tu correo</h1>
            <p class="text-suave mb-4">
                Te enviamos un enlace a <strong>@(string.IsNullOrEmpty(correo) ? "tu correo" : correo)</strong>.
                Ábrelo para activar tu cuenta. El enlace vence en 1 hora; revisa también la carpeta de spam.
            </p>
            @if (!string.IsNullOrEmpty(correo))
            {
                <form asp-action="ReenviarConfirmacion" method="post" class="mb-2">
                    <input type="hidden" name="email" value="@correo" />
                    <button type="submit" class="btn btn-suave">¿No te llegó? Enviar de nuevo</button>
                </form>
            }
            <a asp-action="IniciarSesion" class="btn btn-link">Ir a iniciar sesión</a>
        </div>
    </div>
</div>
