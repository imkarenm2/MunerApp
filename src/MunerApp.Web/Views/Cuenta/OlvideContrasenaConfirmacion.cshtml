@{
    ViewData["Title"] = "Revisa tu correo";
    var correo = TempData["CorreoRecuperacion"] as string;
}
<div class="auth-contenedor">
    <div class="container">
        <div class="mu-card mx-auto p-4 p-md-5 text-center" style="max-width: 480px">
            <div class="icono-circulo exito mb-3 mx-auto"><i class="bi bi-envelope-check" aria-hidden="true"></i></div>
            <h1 class="h3 mb-2">Revisa tu correo</h1>
            <p class="text-suave mb-4">
                Si existe una cuenta con @(string.IsNullOrEmpty(correo) ? "ese correo" : correo), te enviamos un enlace para restablecer tu contraseña.
                El enlace vence en 1 hora. Revisa también la carpeta de spam.
            </p>
            <a asp-action="IniciarSesion" class="btn btn-primary">Volver a iniciar sesión</a>
        </div>
    </div>
</div>
