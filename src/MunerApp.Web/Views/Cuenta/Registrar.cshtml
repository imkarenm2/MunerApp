@model RegistroViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}
<div class="auth-contenedor">
    <div class="container">
        <div class="mu-card auth-card">
            <partial name="_AuthLateral" />
            <div class="auth-formulario">
                <h1 class="h3 mb-1">Crea tu cuenta</h1>
                <p class="text-suave mb-4">Es gratis y te toma menos de un minuto.</p>

                <partial name="_BotonGoogle" />

                <form asp-action="Registrar" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="NombreCompleto" class="form-label"></label>
                        <div class="input-icono">
                            <i class="bi bi-person" aria-hidden="true"></i>
                            <input asp-for="NombreCompleto" class="form-control" autocomplete="name" placeholder="Como aparece en tu documento" />
                        </div>
                        <span asp-validation-for="NombreCompleto"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-icono">
                            <i class="bi bi-envelope" aria-hidden="true"></i>
                            <input asp-for="Email" class="form-control" autocomplete="email" placeholder="tucorreo@ejemplo.com" />
                        </div>
                        <span asp-validation-for="Email"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Contrasena" class="form-label"></label>
                        <div class="input-icono con-boton">
                            <i class="bi bi-lock" aria-hidden="true"></i>
                            <input asp-for="Contrasena" class="form-control" autocomplete="new-password" aria-describedby="ayudaClave" />
                            <button type="button" class="btn-ver-clave" data-ver-clave="Contrasena" aria-label="Mostrar contraseña">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div id="ayudaClave" class="form-text">Mínimo 8 caracteres, con una mayúscula, una minúscula y un número.</div>
                        <span asp-validation-for="Contrasena"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmarContrasena" class="form-label"></label>
                        <div class="input-icono con-boton">
                            <i class="bi bi-lock" aria-hidden="true"></i>
                            <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                            <button type="button" class="btn-ver-clave" data-ver-clave="ConfirmarContrasena" aria-label="Mostrar contraseña">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmarContrasena"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100" data-cargando="Creando tu cuenta...">Crear cuenta</button>
                </form>

                <p class="mt-4 mb-0 text-center text-suave">
                    ¿Ya tienes cuenta? <a asp-action="IniciarSesion" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="fw-semibold">Inicia sesión</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
