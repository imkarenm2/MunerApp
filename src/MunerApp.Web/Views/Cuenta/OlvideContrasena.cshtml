@model OlvideContrasenaViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}
<div class="auth-contenedor">
    <div class="container">
        <div class="mu-card mx-auto p-4 p-md-5" style="max-width: 480px">
            <div class="icono-circulo mb-3"><i class="bi bi-key" aria-hidden="true"></i></div>
            <h1 class="h3 mb-1">¿Olvidaste tu contraseña?</h1>
            <p class="text-suave mb-4">Escribe tu correo y te enviaremos un enlace para crear una nueva.</p>
            <form asp-action="OlvideContrasena" method="post" novalidate>
                <div class="mb-4">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="input-icono">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="tucorreo@ejemplo.com" />
                    </div>
                    <span asp-validation-for="Email"></span>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100" data-cargando="Enviando...">Enviar enlace</button>
            </form>
            <p class="mt-4 mb-0 text-center"><a asp-action="IniciarSesion" class="fw-semibold"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Volver a iniciar sesión</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
