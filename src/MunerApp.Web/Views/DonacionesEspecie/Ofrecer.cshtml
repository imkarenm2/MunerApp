@model OfrecerEspecieViewModel
@{
    ViewData["Title"] = "Donar en especie a " + Model.NombreEsal;
    var hoy = Formatos.Hoy();
    var deNecesidad = Model.NecesidadId is not null;
}
<div class="container py-4 py-md-5" style="max-width: 720px">
    <partial name="_EncabezadoEsal" model='(new LogoEsalModel(Model.NombreEsal, Model.LogoUrl, 48), Model.Slug, "Donar en especie a")' />

    <h1 class="h2 mb-1">@(deNecesidad ? Model.NombreNecesidad : "Ofrecer una donación en especie")</h1>
    <p class="text-suave mb-4">Cuéntale a la fundación qué vas a donar y cuándo. Cuando lo reciba, te llegará el comprobante.</p>

    <form method="post" action="/fundaciones/@Model.Slug/donar-en-especie/ofrecer" novalidate class="mu-card p-4 p-md-5">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="NecesidadId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-3">
            @if (!deNecesidad)
            {
                <div class="col-12">
                    <label asp-for="Articulo" class="form-label"></label>
                    <input asp-for="Articulo" class="form-control" maxlength="120" placeholder="Ej.: Arena aglomerante, cobijas, desparasitante" />
                    <span asp-validation-for="Articulo"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="Categoria" class="form-label"></label>
                    <select asp-for="Categoria" class="form-select">
                        <option value="">Selecciona…</option>
                        @foreach (var c in Enum.GetValues<CategoriaEspecie>())
                        {
                            <option value="@c" selected="@(Model.Categoria == c)">@Textos.De(c)</option>
                        }
                    </select>
                    <span asp-validation-for="Categoria"></span>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="Articulo" />
                <input type="hidden" asp-for="Categoria" />
                <input type="hidden" asp-for="Unidad" />
            }
            <div class="col-6 col-sm-3">
                <label asp-for="Cantidad" class="form-label"></label>
                <input asp-for="Cantidad" class="form-control" type="number" min="1" />
                <span asp-validation-for="Cantidad"></span>
            </div>
            <div class="col-6 col-sm-3">
                <label asp-for="Unidad" class="form-label"></label>
                @if (deNecesidad)
                {
                    <input class="form-control" value="@Model.Unidad" disabled />
                }
                else
                {
                    <input asp-for="Unidad" class="form-control" maxlength="40" placeholder="bultos, unidades" />
                }
                <span asp-validation-for="Unidad"></span>
            </div>

            <div class="col-12">
                <fieldset>
                    <legend class="form-label">¿Cómo llega a la fundación?</legend>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var f in Enum.GetValues<FormaEntregaEspecie>())
                        {
                            <input type="radio" class="btn-check" name="FormaEntrega" id="forma@(f)" value="@f" @(Model.FormaEntrega == f ? "checked" : "") />
                            <label class="chip" for="forma@(f)">@Textos.De(f)</label>
                        }
                    </div>
                    <span asp-validation-for="FormaEntrega"></span>
                </fieldset>
            </div>
            <div class="col-12 @(Model.FormaEntrega == FormaEntregaEspecie.Domicilio ? "" : "d-none")" data-mostrar-si="FormaEntrega=Domicilio">
                <label asp-for="DireccionRecogida" class="form-label"></label>
                <input asp-for="DireccionRecogida" class="form-control" maxlength="200" placeholder="Dirección, barrio y municipio" />
                <div class="form-text">La fundación te escribirá para coordinar. Por ahora solo en Sabana de Occidente.</div>
                <span asp-validation-for="DireccionRecogida"></span>
            </div>
            <div class="col-12 col-sm-6">
                <label asp-for="FechaEntrega" class="form-label"></label>
                <input asp-for="FechaEntrega" class="form-control" type="date" min="@hoy.ToString("yyyy-MM-dd")" max="@hoy.AddDays(60).ToString("yyyy-MM-dd")" />
                <span asp-validation-for="FechaEntrega"></span>
            </div>
            <div class="col-12">
                <label asp-for="Mensaje" class="form-label"></label>
                <textarea asp-for="Mensaje" class="form-control" rows="2" maxlength="300"></textarea>
                <span asp-validation-for="Mensaje"></span>
            </div>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
            <button type="submit" class="btn btn-apoyar btn-lg" data-cargando="Enviando...">Ofrecer mi donación</button>
            <a class="btn btn-link" href="/fundaciones/@Model.Slug/donar-en-especie">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
