@model List<ApadrinamientoItem>
@{
    ViewData["Title"] = "Mis apadrinamientos";
    var activos = Model.Where(a => a.Estado == EstadoApadrinamiento.Activo).ToList();
    var mensual = activos.Sum(a => a.ValorMensual);
}
<div class="container py-4 py-md-5" style="max-width: 960px">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Mis apadrinamientos</h1>
            <p class="text-suave mb-0">A quiénes acompañas con un aporte mensual.</p>
        </div>
        @if (activos.Count > 0)
        {
            <div class="mu-card px-4 py-3 text-end">
                <div class="small text-suave">Tu aporte mensual</div>
                <div class="h4 fw-bold text-principal mb-0">@Formatos.Pesos(mensual)</div>
            </div>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="estado-vacio">
            <div class="icono-circulo acento mb-3"><i class="bi bi-balloon-heart" aria-hidden="true"></i></div>
            <h2 class="h5">Aún no apadrinas a nadie</h2>
            <p class="text-suave">Entra al perfil de una fundación, elige "Apadrinar" y acompaña a uno de sus beneficiarios.</p>
            <a class="btn btn-apoyar" href="/fundaciones">Explorar fundaciones</a>
        </div>
    }
    else
    {
        <div class="d-grid gap-2">
            @foreach (var a in Model)
            {
                <a class="fila-lista mu-card mu-card-hover @(a.Estado == EstadoApadrinamiento.Cancelado ? "documento-oculto" : "")" href="/mis-apadrinamientos/@a.Id">
                    @if (a.FotoUrl is not null)
                    {
                        <img class="beneficiario-foto-mini" src="@a.FotoUrl" alt="" />
                    }
                    else
                    {
                        <span class="beneficiario-foto-mini beneficiario-sin-foto" aria-hidden="true"><i class="bi bi-balloon-heart"></i></span>
                    }
                    <span class="flex-grow-1 min-w-0">
                        <span class="d-block fw-semibold text-body text-truncate">@a.NombreBeneficiario</span>
                        <span class="d-block small text-suave text-truncate">@a.NombreEsal · desde @Formatos.FechaCorta(a.FechaInicio)</span>
                    </span>
                    <span class="text-end">
                        <span class="d-block fw-bold text-body">@Formatos.Pesos(a.ValorMensual)<span class="small fw-normal text-suave"> /mes</span></span>
                        @if (a.Estado == EstadoApadrinamiento.Activo)
                        {
                            <span class="mu-badge exito"><i class="bi bi-heart-fill" aria-hidden="true"></i>Activo</span>
                        }
                        else
                        {
                            <span class="mu-badge"><i class="bi bi-x-circle" aria-hidden="true"></i>Cancelado</span>
                        }
                    </span>
                </a>
            }
        </div>
    }
</div>
