@model BoletinPublicoViewModel
@{
    ViewData["Title"] = "El periódico de MunerApp";
    ViewData["Nav"] = "Boletin";
    ViewData["Descripcion"] = "Noticias, eventos, logros y rendiciones de cuentas de las fundaciones de MunerApp, y las buenas noticias de la plataforma.";
}
<div class="container py-4 py-md-5">
    @if (Model.Periodico is not null)
    {
        <partial name="_Periodico" model="Model.Periodico" />
        <h2 class="periodico-seccion mt-5">Todo el boletín</h2>
    }
    else
    {
        <span class="mu-badge acento mb-2"><i class="bi bi-newspaper" aria-hidden="true"></i>El periódico de MunerApp</span>
        <h1 class="h2 mb-2">Todo el boletín</h1>
        <p class="text-suave mb-4">Noticias, eventos a los que puedes ir, logros y cuentas claras de cada causa.</p>
    }

    <partial name="_Boletin" model="Model" />
</div>
