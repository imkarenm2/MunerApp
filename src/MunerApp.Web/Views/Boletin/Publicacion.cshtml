@model PublicacionDetalleViewModel
@{
    var p = Model.Publicacion;
    ViewData["Title"] = p.Titulo;
    ViewData["Nav"] = "Boletin";
    ViewData["Descripcion"] = p.Resumen;
}
<div class="container py-4 py-md-5" style="max-width: 820px">
    <partial name="_EncabezadoEsal" model='(new LogoEsalModel(p.NombreEsal, Model.LogoUrl, 48), p.SlugEsal, "Boletín de")' />

    <a href="/fundaciones/@p.SlugEsal/boletin" class="small fw-semibold text-decoration-none"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Todo el boletín</a>

    <article class="mt-3">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <partial name="_CategoriaPublicacion" model="p.Categoria" />
            <span class="small text-suave">Publicada el @Formatos.Fecha(Formatos.Local(p.FechaPublicacion))</span>
        </div>
        <h1 class="h2 mb-3">@p.Titulo</h1>

        @if (p.FechaEvento is DateTime ev)
        {
            <div class="mu-card p-4 mb-4">
                <div class="d-flex flex-wrap align-items-center gap-4">
                    <div>
                        <div class="small text-suave">Cuándo</div>
                        <div class="fw-semibold"><i class="bi bi-calendar-event me-1" aria-hidden="true"></i>@Formatos.FechaHora(ev)</div>
                    </div>
                    @if (p.LugarEvento is not null)
                    {
                        <div class="min-w-0">
                            <div class="small text-suave">Dónde</div>
                            <div class="fw-semibold"><i class="bi bi-geo-alt me-1" aria-hidden="true"></i>@p.LugarEvento</div>
                        </div>
                    }
                </div>
                @if (p.EventoPasado)
                {
                    <div class="alert alert-info small mt-3 mb-0">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        <div>Este evento ya pasó.</div>
                    </div>
                }
                else if (Model.UrlCalendario is not null)
                {
                    <a class="btn btn-outline-primary btn-sm mt-3" href="@Model.UrlCalendario" target="_blank" rel="noopener"><i class="bi bi-calendar-plus me-1" aria-hidden="true"></i>Agregar a mi calendario</a>
                }
            </div>
        }

        @if (p.ImagenUrl is not null)
        {
            <img class="publicacion-imagen rounded-4 mb-4" src="@p.ImagenUrl" alt="Imagen de la publicación @p.Titulo" />
        }

        <div class="texto-largo">@Model.Contenido</div>

        @if (Model.CausaId is int causaId)
        {
            <a class="mu-card mu-card-hover d-flex align-items-center gap-3 p-3 mt-4 text-decoration-none text-body" href="/fundaciones/@p.SlugEsal/causas/@causaId">
                <span class="icono-circulo flex-shrink-0" style="width:42px;height:42px;font-size:1.15rem"><i class="bi bi-bullseye" aria-hidden="true"></i></span>
                <span class="flex-grow-1">
                    <span class="d-block small text-suave">Causa relacionada</span>
                    <span class="d-block fw-semibold">@Model.TituloCausa</span>
                </span>
                <i class="bi bi-chevron-right text-suave" aria-hidden="true"></i>
            </a>
        }
    </article>

    @if (Model.Otras.Count > 0)
    {
        <h2 class="h5 mt-5 mb-3">Más del boletín de @p.NombreEsal</h2>
        <div class="row g-3">
            @foreach (var o in Model.Otras)
            {
                <div class="col-12 col-md-4">
                    <partial name="_TarjetaPublicacion" model="o" />
                </div>
            }
        </div>
    }
</div>
