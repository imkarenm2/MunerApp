@model HomeViewModel
@{
    ViewData["Title"] = "Apoya a las fundaciones de Sabana de Occidente";
    ViewData["Descripcion"] = "MunerApp: conoce las fundaciones de Sabana de Occidente, mira en qué se usan las donaciones y elige cómo ayudar.";
    var autenticado = User.Identity?.IsAuthenticated ?? false;
    var conFundacion = Model.Municipios.Count(m => m.Fundaciones > 0);

    // Solo se muestran las cifras que ya tienen algo: un "0" en la portada resta confianza
    var cifras = new List<(string Valor, string Texto)>();
    if (Model.FundacionesPublicadas > 0)
        cifras.Add((Model.FundacionesPublicadas.ToString(), Model.FundacionesPublicadas == 1 ? "fundación publicada" : "fundaciones publicadas"));
    if (Model.Donado > 0)
        cifras.Add((Formatos.Pesos(Model.Donado), "donados y confirmados por las fundaciones"));
    if (Model.BeneficiariosCuidados > 0)
        cifras.Add((Model.BeneficiariosCuidados.ToString(), "animales bajo su cuidado hoy"));
    if (Model.BeneficiariosConHogar > 0)
        cifras.Add((Model.BeneficiariosConHogar.ToString(), "animales ya encontraron hogar"));
}

@if (Model.Donante is { } d)
{
    <section class="banda-donante">
        <div class="container d-flex flex-wrap align-items-center gap-3">
            <span class="fw-bold">Hola, @d.Nombre</span>
            <span class="text-suave small flex-grow-1">
                @if (d.DonacionesConfirmadas > 0)
                {
                    <span>Has aportado <strong>@Formatos.Pesos(d.TotalDonado)</strong> en @d.DonacionesConfirmadas @(d.DonacionesConfirmadas == 1 ? "donación" : "donaciones").</span>
                }
                else
                {
                    <span>Todavía no tienes donaciones registradas.</span>
                }
                @if (d.DonacionesPendientes > 0)
                {
                    <span> @d.DonacionesPendientes por confirmar.</span>
                }
                @if (d.Apadrinamientos > 0)
                {
                    <span> Apadrinas a @d.Apadrinamientos @(d.Apadrinamientos == 1 ? "gato" : "gatos").</span>
                }
            </span>
            <a class="btn btn-sm btn-suave" href="/mis-donaciones">Mis donaciones</a>
            @if (d.Apadrinamientos > 0)
            {
                <a class="btn btn-sm btn-suave" href="/mis-apadrinamientos">Mis apadrinamientos</a>
            }
        </div>
    </section>
}

@* Portada con video de fondo (Pexels, licencia libre). Sin sonido y en bucle; el video solo se descarga en pantallas
   grandes y si la persona no pidió reducir el movimiento (site.js). En el celular se ve la foto. *@
<section class="hero-video">
    <video class="hero-video-fondo" muted loop playsinline preload="none" poster="/video/inicio-portada.jpg"
           data-video="/video/inicio.mp4" aria-hidden="true"></video>
    <div class="hero-video-capa" aria-hidden="true"></div>
    <div class="container hero-video-contenido">
        <span class="hero-etiqueta mb-3">Fundaciones de Sabana de Occidente</span>
        <h1 class="mb-4">Tu ayuda llega, y puedes ver a dónde.</h1>
        <p class="lead mb-4">
            Conoce a las fundaciones de Facatativá, Madrid, Mosquera, Funza y sus vecinos,
            mira en qué usan cada donación y elige cómo apoyar: con dinero, cosas o tu tiempo.
        </p>
        <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3 mb-4">
            <a class="btn btn-light btn-lg" href="@(Model.Causas.Count > 0 ? "/causas" : "/fundaciones")">Quiero ayudar</a>
            @if (!autenticado)
            {
                <a class="enlace-flecha" asp-controller="Cuenta" asp-action="Registrar">Crear mi cuenta <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            }
            else
            {
                <a class="enlace-flecha" href="/fundaciones">Ver fundaciones <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            }
        </div>
        <p class="hero-dato mb-0">
            Cada fundación publica sus documentos y la rendición de cuentas de sus causas.
        </p>
    </div>
    <button type="button" class="hero-video-pausa" data-pausar-video hidden aria-label="Pausar el video de fondo">
        <i class="bi bi-pause-fill" aria-hidden="true"></i>
    </button>
</section>

@* ---------- Cifras reales de la plataforma ---------- *@
@if (cifras.Count > 0)
{
    <section class="cifras">
        <div class="container">
            <div class="cifras-grilla">
                @foreach (var (valor, texto) in cifras)
                {
                    <div class="cifra">
                        <span class="cifra-valor">@valor</span>
                        <span class="cifra-texto">@texto</span>
                    </div>
                }
            </div>
            <p class="small text-suave mt-3 mb-0">Calculado en este momento con lo que registran las fundaciones.</p>
        </div>
    </section>
}

@if (Model.Causas.Count > 0)
{
    <section class="seccion">
        <div class="container">
            <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
                <div>
                    <h2 class="titulo-seccion mb-0">Necesitan tu ayuda ahora</h2>
                </div>
                <a class="enlace-flecha" href="/causas">Ver las @Model.CausasAbiertas causas <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="row g-4">
                @foreach (var c in Model.Causas)
                {
                    <div class="col-12 col-md-6 col-lg-4"><partial name="_TarjetaCausa" model="c" /></div>
                }
            </div>
        </div>
    </section>
}

@if (Model.Apadrinables.Count > 0)
{
    <section class="seccion seccion-blanca">
        <div class="container">
            <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
                <div>
                    <h2 class="titulo-seccion mb-0">Buscan un padrino</h2>
                    <p class="text-suave mb-0 mt-2">Con un aporte mensual cubres su comida y su salud, y recibes noticias de cómo va.@(Model.Padrinos > 0 ? $" Ya hay {Model.Padrinos} padrinos." : "")</p>
                </div>
            </div>
            <div class="row g-4">
                @foreach (var g in Model.Apadrinables)
                {
                    <div class="col-6 col-lg-3">
                        <a class="mu-card mu-card-hover gato-home h-100 text-decoration-none text-body" href="/fundaciones/@g.Slug/apadrinar/@g.Id">
                            @if (g.FotoUrl is not null)
                            {
                                <img src="@g.FotoUrl" alt="Foto de @g.Nombre" loading="lazy" />
                            }
                            <span class="p-3 d-block">
                                <span class="h5 d-block mb-1">@g.Nombre</span>
                                <span class="small text-suave d-block">@g.Fundacion</span>
                            </span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

@* ---------- Dónde estamos ---------- *@
<section class="seccion" id="donde-estamos">
    <div class="container">
        <div class="region mu-card p-4 p-md-5">
            <div class="row g-4 align-items-center">
                <div class="col-12 col-lg-5">
                    <h2 class="titulo-seccion mb-3">Empezamos por Sabana de Occidente</h2>
                    <p class="text-suave mb-0">
                        MunerApp nació en la Universidad de Cundinamarca, extensión Facatativá. Por ahora trabajamos con fundaciones
                        de los ocho municipios de la provincia de Sabana de Occidente, en Cundinamarca. Más adelante llegaremos a otras regiones.
                    </p>
                </div>
                <div class="col-12 col-lg-7">
                    <ul class="municipios">
                        @foreach (var m in Model.Municipios)
                        {
                            @if (m.Fundaciones > 0)
                            {
                                @* Con fundaciones: lleva al directorio filtrado por ese municipio *@
                                <li class="con-fundacion">
                                    <a href="/fundaciones?q=@Uri.EscapeDataString(m.Nombre)" aria-label="Ver las fundaciones de @m.Nombre">
                                        <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                                        <span class="fw-semibold">@m.Nombre</span>
                                        <span class="small">@(m.Fundaciones == 1 ? "1 fundación" : $"{m.Fundaciones} fundaciones") →</span>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                    <span class="fw-semibold">@m.Nombre</span>
                                    <span class="small">Próximamente</span>
                                </li>
                            }
                        }
                    </ul>
                    @if (conFundacion == 0)
                    {
                        <p class="small text-suave mt-3 mb-0">Las primeras fundaciones se están sumando. ¿Conoces una? Cuéntale de MunerApp.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@if (ViewData["Periodico"] is PeriodicoViewModel periodico)
{
    <section class="seccion pb-0" id="periodico" aria-label="El periódico de MunerApp">
        <div class="container">
            <partial name="_Periodico" model="periodico" view-data='new ViewDataDictionary(ViewData) { ["PeriodicoEnInicio"] = true }' />
        </div>
    </section>
}

<section class="seccion seccion-blanca" id="formas-de-ayudar">
    <div class="container">
        <div class="seccion-titulo">
            <h2 class="titulo-seccion">Cómo ayudar</h2>
            <p class="text-suave mb-0">Hay más de una forma de apoyar. Cada fundación elige cómo quiere recibir ayuda y tú eliges la que mejor se ajusta a ti.</p>
        </div>
        @* Bloques con foto: cada forma de ayudar lleva a donde se hace *@
        <div class="formas-apoyo">
            <a class="forma-apoyo" href="/causas">
                <img src="~/img/fotos/mercados.webp" srcset="/img/fotos/mercados-640.webp 640w, /img/fotos/mercados.webp 1000w" sizes="(min-width: 992px) 40vw, (min-width: 576px) 50vw, 100vw" alt="" loading="lazy" />
                <span class="forma-apoyo-texto">
                    <span class="h3 d-block">Donar</span>
                    <span class="d-block">Aporta a una causa en línea o por transferencia, y recibe tu comprobante.</span>
                </span>
            </a>
            <a class="forma-apoyo" href="/fundaciones?ayuda=apadrinar">
                <img src="~/img/fotos/esterilizacion.webp" srcset="/img/fotos/esterilizacion-640.webp 640w, /img/fotos/esterilizacion.webp 1000w" sizes="(min-width: 992px) 40vw, (min-width: 576px) 50vw, 100vw" alt="" loading="lazy" />
                <span class="forma-apoyo-texto">
                    <span class="h4 d-block">Apadrinar</span>
                    <span class="d-block">Acompaña a un beneficiario con un aporte periódico.</span>
                </span>
            </a>
            <a class="forma-apoyo" href="/fundaciones?ayuda=voluntariado">
                <img src="~/img/fotos/arboles.webp" srcset="/img/fotos/arboles-640.webp 640w, /img/fotos/arboles.webp 1000w" sizes="(min-width: 992px) 40vw, (min-width: 576px) 50vw, 100vw" alt="" loading="lazy" />
                <span class="forma-apoyo-texto">
                    <span class="h4 d-block">Ser voluntario</span>
                    <span class="d-block">Dona tu tiempo o lo que sabes hacer.</span>
                </span>
            </a>
            <a class="forma-apoyo" href="/tienda">
                <img src="~/img/fotos/p-bufanda.webp" srcset="/img/fotos/p-bufanda-640.webp 640w, /img/fotos/p-bufanda.webp 1000w" sizes="(min-width: 992px) 40vw, (min-width: 576px) 50vw, 100vw" alt="" loading="lazy" />
                <span class="forma-apoyo-texto">
                    <span class="h4 d-block">Comprar en su tienda</span>
                    <span class="d-block">Productos hechos por las fundaciones. Cada compra también ayuda.</span>
                </span>
            </a>
        </div>
    </div>
</section>

<section class="seccion seccion-oscura" id="transparencia">
    <div class="container">
        <div class="seccion-titulo">
            <h2 class="titulo-seccion mb-2">Transparencia</h2>
            <p class="text-suave mb-0">Sabes a dónde va tu ayuda. Así funciona:</p>
        </div>
        <div class="row g-4">
            <div class="col-12 col-md-4">
                <div class="d-flex gap-3">
                    <span class="paso-numero">1</span>
                    <div>
                        <h3 class="h5 mb-1">Conoce la fundación</h3>
                        <p class="text-suave mb-0">Su historia, su misión y sus documentos legales, en un solo lugar.</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="d-flex gap-3">
                    <span class="paso-numero">2</span>
                    <div>
                        <h3 class="h5 mb-1">Apoya con confianza</h3>
                        <p class="text-suave mb-0">El dinero llega directo a la cuenta de la fundación, y tú recibes tu comprobante.</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="d-flex gap-3">
                    <span class="paso-numero">3</span>
                    <div>
                        <h3 class="h5 mb-1">Mira el resultado</h3>
                        <p class="text-suave mb-0">Cada gasto queda en el libro de fondos de la fundación, con su factura o foto, y lo donado en especie muestra en qué se usó.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-4">
            <a class="btn btn-light" href="/veeduria"><i class="bi bi-binoculars me-1" aria-hidden="true"></i>Ver la veeduría ciudadana</a>
        </div>
    </div>
</section>

@if (Model.Fundaciones.Count > 0)
{
    <section class="seccion">
        <div class="container">
            <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
                <div>
                    <h2 class="titulo-seccion mb-0">Conoce a quién puedes ayudar</h2>
                </div>
                <a class="enlace-flecha" href="/fundaciones">Ver las @Model.FundacionesPublicadas fundaciones <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="row g-4">
                @foreach (var f in Model.Fundaciones)
                {
                    <div class="col-12 col-md-4">
                        <a class="tarjeta-esal h-100" href="/fundaciones/@f.Slug">
                            <span class="tarjeta-marco">
                                @if (f.PortadaUrl is not null)
                                {
                                    <img class="tarjeta-esal-foto" src="@f.PortadaUrl" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span class="tarjeta-esal-foto sin-foto"><partial name="_LogoEsal" model="new LogoEsalModel(f.Nombre, f.LogoUrl, 64)" /></span>
                                }
                            </span>
                            <div class="tarjeta-esal-cuerpo">
                                <h3 class="h5 mb-1">@f.Nombre</h3>
                                <p class="texto-recortado text-suave small mb-3">@(f.DescripcionCorta ?? f.TipoEntidad)</p>
                                <span class="enlace-flecha">Ver perfil <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="seccion pt-0" id="fundaciones">
    <div class="container">
        <div class="cta-fundaciones">
            <div class="cta-fundaciones-texto">
                <h2 class="mb-3">¿Trabajas en una fundación?</h2>
                <p class="mb-4 opacity-75">
                    Si tu fundación trabaja en Sabana de Occidente, construimos MunerApp contigo: levantamos tus necesidades y activamos solo los módulos que te sirven.
                </p>
                <a class="btn btn-light btn-lg" href="/participar">Quiero participar</a>
            </div>
            <img src="~/img/fotos/comunidad.webp" srcset="/img/fotos/comunidad-640.webp 640w, /img/fotos/comunidad.webp 1000w" sizes="(min-width: 992px) 40vw, 100vw" alt="Una voluntaria entrega un mercado a una vecina" loading="lazy" />
        </div>
    </div>
</section>
