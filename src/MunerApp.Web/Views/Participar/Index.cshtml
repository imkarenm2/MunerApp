@model ParticiparViewModel
@{
    ViewData["Title"] = "Quiero participar";
}
<div class="container py-4 py-md-5" style="max-width: 760px">
    <div class="sobretitulo mb-2">Para fundaciones</div>
    <h1 class="h2 mb-2">Quiero que mi fundación esté en MunerApp</h1>
    <p class="text-suave mb-4">Déjanos tus datos y te contactamos. Antes de activar la plataforma hacemos una reunión para conocer lo que necesitan y activar solo los módulos que les sirven.</p>

    <form asp-action="Index" method="post" novalidate class="mu-card p-4 p-md-5"
          data-confirmar="Te contactaremos al correo o al celular que escribiste."
          data-confirmar-titulo="¿Enviar la solicitud?" data-confirmar-boton="Sí, enviar">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-3">
            <div class="col-12 col-md-7">
                <label asp-for="NombreFundacion" class="form-label"></label>
                <input asp-for="NombreFundacion" class="form-control" maxlength="150" />
                <span asp-validation-for="NombreFundacion"></span>
            </div>
            <div class="col-12 col-md-5">
                <label asp-for="TipoEntidad" class="form-label"></label>
                <select asp-for="TipoEntidad" class="form-select">
                    <option value="">Selecciona…</option>
                    @foreach (var t in TiposEntidad.Todos)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
                <span asp-validation-for="TipoEntidad"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Ciudad" class="form-label"></label>
                <select asp-for="Ciudad" class="form-select">
                    <option value="">Selecciona el municipio</option>
                    @foreach (var m in Region.Municipios)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
                <div class="form-text">Por ahora MunerApp funciona solo en Sabana de Occidente.</div>
                <span asp-validation-for="Ciudad"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="NombreContacto" class="form-label"></label>
                <input asp-for="NombreContacto" class="form-control" maxlength="150" />
                <span asp-validation-for="NombreContacto"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" />
                <span asp-validation-for="Correo"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Telefono" class="form-label"></label>
                <input asp-for="Telefono" class="form-control" inputmode="tel" placeholder="3001234567" />
                <span asp-validation-for="Telefono"></span>
            </div>
            <div class="col-12">
                <label asp-for="Mensaje" class="form-label"></label>
                <textarea asp-for="Mensaje" class="form-control" rows="3" maxlength="300" data-contador></textarea>
                <span asp-validation-for="Mensaje"></span>
            </div>
            <div class="visually-hidden" aria-hidden="true">
                <label for="SitioWeb">No llenes este campo</label>
                <input id="SitioWeb" name="SitioWeb" tabindex="-1" autocomplete="off" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg mt-4" data-cargando="Enviando...">Enviar solicitud</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
