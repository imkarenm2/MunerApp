@* Cómo comprar el producto. La plataforma no cobra en la tienda: la compra se acuerda con la fundación (HU-024). *@
@model ProductoDetalleViewModel
@if (Model.Agotado)
{
    <div class="alert alert-warning mb-0">
        <i class="bi bi-hourglass" aria-hidden="true"></i>
        <div>Este producto está agotado por ahora. Vuelve pronto o mira otros productos de la fundación.</div>
    </div>
}
else
{
    <p class="fw-semibold mb-1"><i class="bi bi-chat-heart me-1" aria-hidden="true"></i>¿Cómo lo compro?</p>
    <p class="small text-suave mb-3">Acuerdas la compra directamente con la fundación: forma de pago y entrega. Lo que pagas llega a ella.</p>
    <a class="btn btn-apoyar btn-lg w-100" href="/fundaciones/@Model.SlugEsal#contacto"><i class="bi bi-telephone me-2" aria-hidden="true"></i>Contactar a la fundación</a>
}
