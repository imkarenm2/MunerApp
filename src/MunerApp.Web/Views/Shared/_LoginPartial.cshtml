@inject SignInManager<Usuario> SignInManager
@{
    var nombre = User.FindFirst(MunerAppClaims.NombreCompleto)?.Value ?? User.Identity?.Name ?? "";
    var iniciales = string.Concat(nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
}

@if (SignInManager.IsSignedIn(User))
{
    <div class="dropdown">
        <button class="btn btn-link text-decoration-none d-flex align-items-center gap-2 p-1" type="button"
                data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menú de mi cuenta">
            <span class="mu-avatar">@iniciales</span>
            <span class="d-lg-none text-body fw-semibold">@nombre</span>
            <i class="bi bi-chevron-down small text-suave" aria-hidden="true"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2" style="min-width: 220px">
            <li class="px-3 py-2">
                <div class="fw-semibold">@nombre</div>
                <div class="small text-suave">@User.Identity?.Name</div>
            </li>
            <li><hr class="dropdown-divider" /></li>
            @if (User.IsInRole(Roles.SuperAdministrador))
            {
                <li><a class="dropdown-item rounded-2" asp-area="Plataforma" asp-controller="Esales" asp-action="Index"><i class="bi bi-shield-lock me-2" aria-hidden="true"></i>Panel de plataforma</a></li>
            }
            @if (User.IsInRole(Roles.AdministradorESAL) || User.IsInRole(Roles.Voluntario))
            {
                <li><a class="dropdown-item rounded-2" asp-area="Fundacion" asp-controller="Panel" asp-action="Index"><i class="bi bi-grid me-2" aria-hidden="true"></i>Panel de mi fundación</a></li>
            }
            @* TODO Sprint 2 (HU-014): "Mis donaciones" para donantes *@
            <li>
                <form asp-area="" asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                    <button type="submit" class="dropdown-item rounded-2">
                        <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Cerrar sesión
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <div class="d-flex flex-column flex-lg-row gap-2">
        <a class="btn btn-suave" asp-area="" asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a>
        <a class="btn btn-primary" asp-area="" asp-controller="Cuenta" asp-action="Registrar">Crear cuenta</a>
    </div>
}
