<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["Descripcion"] as string ?? "MunerApp: conoce fundaciones, mira en qué se usan las donaciones y elige cómo ayudar.")" />
    <meta name="theme-color" content="#0F5257" />
    <title>@ViewData["Title"] · MunerApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Nunito:wght@700;800;900&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Estilos", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <a class="saltar-contenido" href="#contenido">Saltar al contenido</a>

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg mu-navbar py-2" aria-label="Menú principal">
            <div class="container">
                <partial name="_Logo" />
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                        aria-controls="menu" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav mx-lg-auto my-3 my-lg-0 gap-lg-1">
                        @* El superadmin y el equipo de una fundación trabajan desde su panel: no se les muestra el menú de los donantes *@
                        @if (User.IsInRole(Roles.SuperAdministrador))
                        {
                            <li class="nav-item"><a class="nav-link active" asp-area="Plataforma" asp-controller="Resumen" asp-action="Index">Administración de MunerApp</a></li>
                        }
                        else if (User.IsInRole(Roles.AdministradorESAL) || User.IsInRole(Roles.Voluntario))
                        {
                            <li class="nav-item"><a class="nav-link active" asp-area="Fundacion" asp-controller="Panel" asp-action="Index">Mi fundación</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @(ViewData["Nav"] as string == "Fundaciones" ? "active" : "")" href="/fundaciones">Fundaciones</a></li>
                            <li class="nav-item"><a class="nav-link @(ViewData["Nav"] as string == "Causas" ? "active" : "")" href="/causas">Causas</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="formas-de-ayudar">Cómo ayudar</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="transparencia">Transparencia</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main id="contenido" class="flex-grow-1">
        @if (ViewData["Panel"] is not true)
        {
            <partial name="_Alertas" />
        }
        @RenderBody()
    </main>

    @if (ViewData["Panel"] is not true)
    {
    <footer class="mu-footer mt-auto">
        <div class="container">
            <div class="row gy-4">
                <div class="col-12 col-md-5">
                    <partial name="_Logo" />
                    <p class="text-suave mt-3 mb-0" style="max-width: 340px">
                        Una plataforma para que la comunidad conozca a las fundaciones, vea en qué se usa su ayuda y elija cómo apoyar.
                    </p>
                </div>
                <div class="col-6 col-md-3">
                    <h3 class="h6 fw-bold">Plataforma</h3>
                    <ul class="list-unstyled d-grid gap-2 mb-0">
                        <li><a href="/fundaciones">Fundaciones</a></li>
                        <li><a href="/causas">Causas</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="formas-de-ayudar">Cómo ayudar</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="transparencia">Transparencia</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-4">
                    <h3 class="h6 fw-bold">Proyecto</h3>
                    <p class="text-suave mb-0">Proyecto de Gestión del Conocimiento · Universidad de Cundinamarca, Extensión Facatativá.</p>
                </div>
            </div>
            <hr class="my-4" />
            <p class="small text-suave mb-0">© @DateTime.Now.Year MunerApp</p>
        </div>
    </footer>
    }

    <!-- Ventana de confirmación general: se usa con <form data-confirmar="..."> (ver site.js) -->
    <div class="modal fade" id="modalConfirmar" tabindex="-1" aria-labelledby="modalConfirmarTitulo" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content mu-modal">
                <div class="modal-body p-4 text-center">
                    <div class="mu-modal-icono mb-3" data-icono aria-hidden="true"><i class="bi bi-question-lg"></i></div>
                    <h2 class="h5 fw-bold mb-2" id="modalConfirmarTitulo" data-titulo>¿Estás seguro?</h2>
                    <p class="text-suave mb-0" data-mensaje></p>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4 justify-content-center gap-2">
                    <button type="button" class="btn btn-suave" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" data-aceptar>Confirmar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
