@{
    var nav = ViewData["Nav"] as string;
    var esInicio = ViewContext.RouteData.Values["area"] is null or ""
        && ViewContext.RouteData.Values["controller"] as string == "Home"
        && ViewContext.RouteData.Values["action"] as string == "Index";
    var esEquipoOAdmin = User.IsInRole(Roles.SuperAdministrador)
        || User.IsInRole(Roles.AdministradorESAL) || User.IsInRole(Roles.Voluntario);
    // Barra de abajo en el celular (visitantes y donantes): los botones principales siempre a la mano
    var barraInferior = ViewData["Panel"] is not true && !esEquipoOAdmin;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["Descripcion"] as string ?? "MunerApp: conoce fundaciones, mira en qué se usan las donaciones y elige cómo ayudar.")" />
    <meta name="theme-color" content="#1F4D3A" />
    <title>@ViewData["Title"] · MunerApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Estilos", required: false)
</head>
<body class="d-flex flex-column min-vh-100 @(barraInferior ? "con-barra-inferior" : "") @(ViewData["ConBarraAccion"] is true ? "con-barra-accion" : "")">
    <a class="saltar-contenido" href="#contenido">Saltar al contenido</a>

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg mu-navbar py-2" aria-label="Menú principal">
            <div class="container">
                <partial name="_Logo" />
                @* En el celular el botón dice "Menú": un ícono de tres rayas solo no lo reconoce todo el mundo *@
                <button class="navbar-toggler boton-menu" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                        aria-controls="menu" aria-expanded="false">
                    <span class="navbar-toggler-icon" aria-hidden="true"></span>
                    <span class="boton-menu-texto">Menú</span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav mx-lg-auto my-3 my-lg-0 gap-lg-1">
                        @* El superadmin y el equipo de una fundación trabajan desde su panel: no se les muestra el menú de los donantes *@
                        @if (User.IsInRole(Roles.SuperAdministrador))
                        {
                            <li class="nav-item"><a class="nav-link active" asp-area="Plataforma" asp-controller="Resumen" asp-action="Index">Administración de MunerApp</a></li>
                        }
                        else if (User.IsInRole(Roles.AdministradorESAL) || User.IsInRole(Roles.Voluntario))
                        {
                            <li class="nav-item"><a class="nav-link active" asp-area="Fundacion" asp-controller="Panel" asp-action="Index">Mi fundación</a></li>
                        }
                        else
                        {
                            <li class="nav-item d-lg-none"><a class="nav-link @(esInicio ? "active" : "")" href="/"><i class="bi bi-house-door" aria-hidden="true"></i>Inicio</a></li>
                            <li class="nav-item"><a class="nav-link @(nav == "Fundaciones" ? "active" : "")" href="/fundaciones"><i class="bi bi-buildings" aria-hidden="true"></i>Fundaciones</a></li>
                            <li class="nav-item"><a class="nav-link @(nav == "Causas" ? "active" : "")" href="/causas"><i class="bi bi-bullseye" aria-hidden="true"></i>Causas</a></li>
                            <li class="nav-item"><a class="nav-link @(nav == "Tienda" ? "active" : "")" href="/tienda"><i class="bi bi-shop" aria-hidden="true"></i>Tienda</a></li>
                            <li class="nav-item"><a class="nav-link @(nav == "Boletin" ? "active" : "")" href="/boletin"><i class="bi bi-newspaper" aria-hidden="true"></i>Boletín</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="formas-de-ayudar"><i class="bi bi-hand-thumbs-up" aria-hidden="true"></i>Cómo ayudar</a></li>
                            <li class="nav-item"><a class="nav-link @(nav == "Veeduria" ? "active" : "")" href="/veeduria"><i class="bi bi-binoculars" aria-hidden="true"></i>Veeduría</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main id="contenido" class="flex-grow-1">
        @if (ViewData["Panel"] is not true)
        {
            <partial name="_Alertas" />
        }
        @RenderBody()
    </main>

    @if (ViewData["Panel"] is not true)
    {
    <footer class="mu-footer mt-auto">
        <div class="container">
            <div class="row gy-4">
                <div class="col-12 col-md-5">
                    <partial name="_Logo" />
                    <p class="text-suave mt-3 mb-0" style="max-width: 340px">
                        Una plataforma para que la comunidad conozca a las fundaciones, vea en qué se usa su ayuda y elija cómo apoyar.
                    </p>
                </div>
                <div class="col-6 col-md-3">
                    <h3 class="h6 fw-bold">Plataforma</h3>
                    <ul class="list-unstyled d-grid gap-2 mb-0">
                        <li><a href="/fundaciones">Fundaciones</a></li>
                        <li><a href="/causas">Causas</a></li>
                        <li><a href="/tienda">Tienda solidaria</a></li>
                        <li><a href="/boletin">Boletín</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="formas-de-ayudar">Cómo ayudar</a></li>
                        <li><a href="/veeduria">Veeduría ciudadana</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-4">
                    <h3 class="h6 fw-bold">Proyecto</h3>
                    <p class="text-suave mb-0">Proyecto de Gestión del Conocimiento · Universidad de Cundinamarca, Extensión Facatativá.</p>
                </div>
            </div>
            <hr class="my-4" />
            <p class="small text-suave mb-0">© @Formatos.Hoy().Year MunerApp · <a href="/privacidad">Política de privacidad</a></p>
        </div>
    </footer>
    }

    @if (barraInferior)
    {
        var autenticado = User.Identity?.IsAuthenticated ?? false;
        <nav class="barra-inferior d-lg-none" aria-label="Accesos rápidos">
            <a href="/" class="@(esInicio ? "activo" : "")" aria-current="@(esInicio ? "page" : null)"><i class="bi bi-house-door" aria-hidden="true"></i>Inicio</a>
            <a href="/fundaciones" class="@(nav == "Fundaciones" ? "activo" : "")" aria-current="@(nav == "Fundaciones" ? "page" : null)"><i class="bi bi-buildings" aria-hidden="true"></i>Fundaciones</a>
            <a href="/causas" class="@(nav == "Causas" ? "activo" : "")" aria-current="@(nav == "Causas" ? "page" : null)"><i class="bi bi-bullseye" aria-hidden="true"></i>Causas</a>
            <a href="/tienda" class="@(nav == "Tienda" ? "activo" : "")" aria-current="@(nav == "Tienda" ? "page" : null)"><i class="bi bi-shop" aria-hidden="true"></i>Tienda</a>
            @if (autenticado)
            {
                <a href="/mis-donaciones" class="@(nav == "MisAportes" ? "activo" : "")" aria-current="@(nav == "MisAportes" ? "page" : null)"><i class="bi bi-heart" aria-hidden="true"></i>Mis aportes</a>
            }
            else
            {
                <a asp-area="" asp-controller="Cuenta" asp-action="IniciarSesion"><i class="bi bi-person-circle" aria-hidden="true"></i>Ingresar</a>
            }
        </nav>
    }

    <!-- Ventana de confirmación general: se usa con <form data-confirmar="..."> (ver site.js) -->
    <div class="modal fade" id="modalConfirmar" tabindex="-1" aria-labelledby="modalConfirmarTitulo" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content mu-modal">
                <div class="modal-body p-4 text-center">
                    <div class="mu-modal-icono mb-3" data-icono aria-hidden="true"><i class="bi bi-question-lg"></i></div>
                    <h2 class="h5 fw-bold mb-2" id="modalConfirmarTitulo" data-titulo>¿Estás seguro?</h2>
                    <p class="text-suave mb-0" data-mensaje></p>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4 justify-content-center gap-2">
                    <button type="button" class="btn btn-suave" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" data-aceptar>Confirmar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
