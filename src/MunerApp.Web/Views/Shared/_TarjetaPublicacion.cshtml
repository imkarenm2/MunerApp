@* Tarjeta de una publicación del boletín (HU-028) *@
@model PublicacionTarjeta
<a class="tarjeta-publicacion text-decoration-none text-body" href="@Model.Url" aria-label="Leer @Model.Titulo">
    @if (Model.ImagenUrl is not null)
    {
        <span class="tarjeta-marco"><img class="publicacion-imagen" src="@Model.ImagenUrl" alt="" loading="lazy" /></span>
    }
    <span class="tarjeta-texto">
        <span class="d-flex flex-wrap align-items-center gap-2">
            <partial name="_CategoriaPublicacion" model="Model.Categoria" />
            <span class="small text-suave">@Formatos.FechaCorta(Model.FechaPublicacion)</span>
        </span>
        <span class="tarjeta-titulo">@Model.Titulo</span>
        @if (Model.FechaEvento is DateTime ev)
        {
            <span class="small @(Model.EventoPasado ? "text-suave" : "fw-semibold")">
                @Formatos.FechaHora(ev)@(Model.EventoPasado ? " · ya pasó" : "")
            </span>
        }
        @if (Model.Resumen is not null)
        {
            <span class="small text-suave texto-recortado">@Model.Resumen</span>
        }
        @if (Model.MostrarFundacion)
        {
            <span class="tarjeta-fundacion">@Model.NombreEsal</span>
        }
    </span>
</a>
