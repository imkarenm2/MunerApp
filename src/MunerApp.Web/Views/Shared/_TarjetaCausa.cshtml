@* Tarjeta de una causa de recaudación: foto, meta, monto recaudado, barra de progreso y días restantes (HU-042) *@
@model CausaTarjeta
<a class="tarjeta-causa text-decoration-none text-body @(Model.Cerrada ? "cerrada" : "")" href="@Model.Url"
   aria-label="Ver la causa @Model.Titulo">
    <span class="tarjeta-marco">
        @if (Model.FotoUrl is not null)
        {
            <img class="tarjeta-causa-foto" src="@Model.FotoUrl" alt="Foto de la causa @Model.Titulo" loading="lazy" />
        }
        else
        {
            <span class="tarjeta-causa-foto beneficiario-sin-foto d-flex" aria-hidden="true"><i class="bi bi-bullseye"></i></span>
        }
        @if (Model.Cerrada || Model.Pausada)
        {
            <span class="tarjeta-estado">@(Model.Cerrada ? "Cerrada" : "En pausa")</span>
        }
    </span>
    <span class="tarjeta-texto">
        @if (Model.MostrarFundacion)
        {
            <span class="tarjeta-fundacion">@Model.NombreEsal</span>
        }
        <span class="tarjeta-titulo">@Model.Titulo</span>
        <span class="mu-progreso @(Model.Cerrada ? "cerrada" : "")" role="progressbar" aria-valuenow="@Model.Porcentaje" aria-valuemin="0" aria-valuemax="100" aria-label="Progreso de la causa @Model.Titulo">
            <span style="width: @(Model.Porcentaje)%"></span>
        </span>
        <span class="tarjeta-cifras">
            <strong>@Formatos.Pesos(Model.Recaudado)</strong> de @Formatos.Pesos(Model.Meta)
            <span aria-hidden="true">·</span>
            @(Model.Cerrada ? "Terminó el " + Formatos.Fecha(Model.FechaFin) : Formatos.DiasRestantes(Model.DiasRestantes).ToLowerInvariant())
        </span>
        @* Un botón visible: no todos saben que la tarjeta completa se puede tocar *@
        <span class="btn btn-outline-dark btn-sm tarjeta-accion" aria-hidden="true">
            @(Model.Cerrada || Model.Pausada ? "Ver la causa" : "Ver y donar")
        </span>
    </span>
</a>
