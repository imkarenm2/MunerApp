@* Tarjeta de un producto de la tienda: foto, nombre, precio y si está agotado (HU-024) *@
@model ProductoTarjeta
<a class="tarjeta-producto text-decoration-none text-body @(Model.Agotado ? "agotado" : "")" href="@Model.Url"
   aria-label="Ver @Model.Nombre">
    <span class="tarjeta-marco">
        @if (Model.FotoUrl is not null)
        {
            <img class="producto-foto" src="@Model.FotoUrl" alt="Foto de @Model.Nombre" loading="lazy" />
        }
        else
        {
            <span class="producto-foto beneficiario-sin-foto" aria-hidden="true"><i class="bi bi-bag-heart"></i></span>
        }
        @if (Model.Agotado)
        {
            <span class="tarjeta-estado">Agotado</span>
        }
    </span>
    <span class="tarjeta-texto">
        @if (Model.MostrarFundacion)
        {
            <span class="tarjeta-fundacion">@Model.NombreEsal</span>
        }
        <span class="tarjeta-titulo">@Model.Nombre</span>
        <span class="tarjeta-precio">@Formatos.Pesos(Model.Precio)</span>
        <span class="btn btn-outline-dark btn-sm tarjeta-accion" aria-hidden="true">Ver producto</span>
    </span>
</a>
