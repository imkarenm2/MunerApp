@model int
<a class="btn btn-link campana p-1 position-relative" href="/notificaciones"
   aria-label="@(Model == 0 ? "Notificaciones" : $"Notificaciones: {Model} sin leer")" title="Notificaciones">
    <i class="bi @(Model > 0 ? "bi-bell-fill" : "bi-bell")" aria-hidden="true"></i>
    @if (Model > 0)
    {
        <span class="campana-contador">@(Model > 9 ? "9+" : Model.ToString())</span>
    }
</a>
